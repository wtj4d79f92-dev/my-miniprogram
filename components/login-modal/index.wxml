<!-- 登录页：全屏覆盖，顶部返回 + 品牌区 + 协议勾选 + 主次登录按钮，底部保留「暂不登录」 -->
<view class="login-page" wx:if="{{visible}}">
  <view class="login-nav" style="{{navStyle}}">
    <view
      class="login-nav-back"
      style="{{navButtonStyle}}"
      bindtap="onNavBack"
      hover-class="login-nav-back-hover"
      hover-stay-time="100"
    >
      <view class="icon-chevron"></view>
    </view>
    <text class="login-nav-title">{{navTitle}}</text>
  </view>

  <!-- ① 登录首页 -->
  <view class="login-main" wx:if="{{step === 'main'}}">
    <scroll-view class="login-scroll" scroll-y type="list">
      <view class="brand">
        <text class="brand-name">{{appName}}</text>
      </view>

      <view class="brand-art">
        <image class="brand-art-logo" src="/assets/logo.png" mode="aspectFill"></image>
      </view>

      <view class="login-reason" wx:if="{{reason}}"><text class="login-reason-text">{{reason}}</text></view>
      <text class="login-hint">未注册手机号验证登录后自动注册{{appName}}账号</text>

      <view class="agree-row {{agreeShake ? 'agree-row-shake' : ''}}">
        <view class="checkbox {{agreed ? 'checkbox-checked' : ''}}" bindtap="toggleAgree">
          <view class="checkbox-tick" wx:if="{{agreed}}"></view>
        </view>
        <view class="agree-text">
          <text class="agree-plain" bindtap="toggleAgree">我已阅读并同意</text>
          <text class="agree-link" data-key="service" catchtap="openAgreement">《用户服务协议》</text>
          <text class="agree-plain" bindtap="toggleAgree">和</text>
          <text class="agree-link" data-key="privacy" catchtap="openAgreement">《隐私政策》</text>
        </view>
      </view>

      <view class="login-actions">
        <block wx:if="{{useMock}}">
          <!-- 演示模式：登录过的手机号直接复用，否则先输入手机号 -->
          <view class="login-btn login-btn-main" bindtap="onPrimaryTap">
            <text class="login-btn-title">{{knownPhone ? '登录此账号' : '手机号快捷登录'}}</text>
            <text class="login-btn-sub" wx:if="{{knownPhone}}">{{maskedPhone}}</text>
          </view>
          <view class="login-btn login-btn-ghost" wx:if="{{knownPhone}}" bindtap="onSwitchPhone">
            <text>手机号快捷登录</text>
          </view>
          <view class="switch-phone" bindtap="onSwitchPhone">
            <view class="icon-phone"><view class="icon-phone-line"></view></view>
            <text class="switch-phone-text">切换手机号</text>
          </view>
        </block>

        <block wx:else>
          <!-- 云开发模式：openid 一键登录，或授权微信手机号 -->
          <view class="login-btn login-btn-main" bindtap="onWechatLogin">
            <text class="login-btn-title">微信一键登录</text>
          </view>
          <button
            class="login-btn-reset"
            open-type="getPhoneNumber"
            bindgetphonenumber="onGetPhoneNumber"
          >
            <view class="login-btn login-btn-ghost"><text>手机号快捷登录</text></view>
          </button>
        </block>
      </view>

      <view class="login-scroll-space"></view>
    </scroll-view>
    <view class="login-foot">
      <text class="not-login" bindtap="cancel">暂不登录</text>
    </view>
  </view>

  <!-- ② 输入手机号 -->
  <view class="login-main login-main-phone" wx:elif="{{step === 'phone'}}">
    <text class="phone-title">请输入手机号</text>
    <text class="phone-sub">未注册的手机号验证登录后将自动注册{{appName}}账号</text>
    <view class="phone-field">
      <text class="phone-prefix">+86</text>
      <input
        class="phone-input"
        type="number"
        maxlength="11"
        placeholder="手机号"
        placeholder-class="phone-placeholder"
        value="{{phone}}"
        focus="{{step === 'phone'}}"
        bindinput="onPhoneInput"
      />
    </view>
    <view
      class="login-btn login-btn-main login-btn-single {{phoneValid ? '' : 'login-btn-disabled'}}"
      bindtap="submitPhone"
    >
      <text class="login-btn-title">{{submitting ? '登录中…' : '登录'}}</text>
    </view>
    <text class="phone-tips">演示模式下不会发送短信，登录信息仅保存在本机</text>
  </view>

  <!-- ③ 完善头像昵称：新用户登录成功后引导一次，可选 -->
  <view class="login-main login-main-profile" wx:elif="{{step === 'profile'}}">
    <text class="profile-title">完善头像昵称</text>
    <text class="profile-sub">微信头像昵称需本人点选，两下即可带上</text>

    <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onProfileAvatar">
      <avatar url="{{profileAvatar}}" color="#8FCFBA" text="{{profileNick ? profileNick : '友'}}" size="lg"></avatar>
      <text class="profile-avatar-tip">点击选择微信头像</text>
    </button>

    <view class="profile-nick-row">
      <text class="profile-nick-label">昵称</text>
      <input
        class="profile-nick-input"
        type="nickname"
        value="{{profileNick}}"
        maxlength="20"
        placeholder="点击可选用微信昵称"
        placeholder-class="profile-nick-placeholder"
        bindinput="onProfileNick"
      />
    </view>

    <view class="login-btn login-btn-main login-btn-single profile-save" bindtap="saveProfile">
      <text class="login-btn-title">{{profileSaving ? '保存中…' : '保存'}}</text>
    </view>
    <view class="login-btn login-btn-ghost profile-skip" bindtap="skipProfile"><text>暂不完善</text></view>
    <text class="profile-tips">头像昵称会展示在活动卡片与报名名单里，之后可在「我的」里随时修改</text>
  </view>

  <!-- ④ 协议正文 -->
  <view class="login-main login-main-agreement" wx:else>
    <text class="agreement-meta">更新日期：{{agreement.updatedAt}}</text>
    <scroll-view class="agreement-body" scroll-y type="list">
      <view class="agreement-block" wx:for="{{agreement.blocks}}" wx:key="key">
        <text class="agreement-text">
          <text
            wx:for="{{item.segments}}"
            wx:for-item="seg"
            wx:key="i"
            class="{{seg.strong ? 'agreement-strong' : ''}}"
          >{{seg.text}}</text>
        </text>
      </view>
      <view class="agreement-space"></view>
    </scroll-view>
    <view class="login-btn login-btn-ghost agreement-back" bindtap="backToMain">
      <text>返回登录</text>
    </view>
  </view>
</view>
