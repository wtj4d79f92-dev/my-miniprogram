.poster-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 901;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  box-sizing: border-box;
}

.poster-wrap {
  position: relative;
  width: 560rpx;
  height: 956rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
}

.poster-img {
  display: block;
  width: 560rpx;
  height: 956rpx;
}

.poster-loading {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.86);
  color: var(--text-sub);
  font-size: 26rpx;
}

.poster-tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.poster-actions {
  display: flex;
  width: 560rpx;
  margin-top: 24rpx;
}

/* 三个按钮统一尺寸：全局 .btn-ghost 为 72rpx、.btn-primary 为 88rpx，这里拉平 */
.poster-actions .poster-btn {
  flex: 1;
  margin: 0 10rpx;
  height: 80rpx;
  font-size: 28rpx;
}

/* 浅色次要按钮：深色蒙层上保持白底深字，文案清晰可读 */
.poster-actions .btn-ghost {
  background: rgba(255, 255, 255, 0.92);
  color: #2d3748;
}

/* 主按钮保留品牌渐变，避免被上面的浅底样式覆盖成白底白字 */
.poster-actions .btn-primary {
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  color: #ffffff;
}
