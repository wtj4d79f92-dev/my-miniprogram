<view wx:if="{{visible}}">
  <view class="mask" bindtap="close"></view>
  <view class="poster-layer">
    <view class="poster-wrap">
      <image
        wx:if="{{posterPath}}"
        class="poster-img"
        src="{{posterPath}}"
        mode="aspectFill"
        show-menu-by-longpress
      ></image>
      <view wx:if="{{generating}}" class="poster-loading"><text>海报生成中…</text></view>
      <view wx:elif="{{!posterPath}}" class="poster-loading"><text>海报生成失败，请重试</text></view>
    </view>
    <text class="poster-tip">长按海报可转发给好友</text>
    <view class="poster-actions">
      <view class="btn-ghost poster-btn" bindtap="close" hover-class="btn-press" hover-start-time="0" hover-stay-time="80"><text>关闭</text></view>
      <view class="btn-ghost poster-btn" bindtap="forward" hover-class="btn-press" hover-start-time="0" hover-stay-time="80"><text>转发</text></view>
      <view class="btn-primary poster-btn" bindtap="save" hover-class="btn-press" hover-start-time="0" hover-stay-time="80"><text>保存图片</text></view>
    </view>
  </view>
</view>
