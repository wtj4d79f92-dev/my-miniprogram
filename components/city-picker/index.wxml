<view wx:if="{{visible}}">
  <view class="mask" bindtap="close"></view>
  <view class="sheet" catchtap="noop">
    <view class="sheet-head">
      <text class="sheet-close" bindtap="close" hover-class="row-press" hover-start-time="0" hover-stay-time="80">取消</text>
      <text class="sheet-title">选择城市</text>
      <text class="city-confirm" bindtap="confirm" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">确定</text>
    </view>
    <!-- 定位入口收进城市弹层：合并了页面上的「点击定位」，能力不丢 -->
    <view class="sheet-locate" bindtap="onLocate" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
      <text class="sheet-locate-icon">📍</text>
      <text class="sheet-locate-text">定位到当前城市</text>
    </view>
    <picker-view class="city-picker" indicator-style="height: 88rpx;" value="{{value}}" bindchange="onPickerChange">
      <picker-view-column>
        <view class="picker-item" wx:for="{{provinceNames}}" wx:key="*this">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view class="picker-item" wx:for="{{cityLabels}}" wx:key="*this">{{item}}</view>
      </picker-view-column>
    </picker-view>
  </view>
</view>
