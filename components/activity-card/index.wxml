<!-- hover-class 走轻量的按压态：手指按下时卡片下沉、投影收拢，松手弹回 -->
<view
  class="act-card"
  bindtap="onTap"
  hover-class="card-press"
  hover-start-time="0"
  hover-stay-time="80"
>
  <!-- 没传封面图的活动不再铺默认海报：那块 280rpx 的装饰图只是重复的渐变 + 同一句 slogan，
       列表里白白占掉半屏，直接整块省掉。活动类型不再占顶部一行，统一挪到卡片底部的费用行左侧
       （见下方 act-foot 里的类型标签） -->
  <view wx:if="{{coverSrc}}" class="act-cover" style="background: {{act.bg}};">
    <image class="act-cover-img" src="{{coverSrc}}" mode="aspectFill" binderror="onCoverError"></image>
    <view wx:if="{{statusText}}" class="act-closed {{statusClass}}"><text>{{statusText}}</text></view>
  </view>

  <view class="act-body">
    <!-- 无封面时的状态窄标签：状态文案与角标同源（见 js 里的 resolveStatus），口径不会走偏。
         活动类型已经挪到卡片底部，这行只在有审核 / 关闭状态时才出现 -->
    <view wx:if="{{!coverSrc && statusText && !showToolbar}}" class="act-flat-head">
      <text class="act-status-flat tone-{{statusTone}}">{{statusText}}</text>
    </view>

    <view class="act-title-row">
      <text wx:if="{{act.showMetrics && act.difficulty}}" class="act-difficulty">{{act.difficultyText}}</text>
      <text class="tag tag-orange act-tag" wx:for="{{act.tagNames}}" wx:key="*this">{{item}}</text>
      <text class="act-title ellipsis">{{act.title}}</text>
    </view>

    <view class="act-row">
      <avatar url="{{act.organizer.avatarUrl}}" color="{{act.organizer.avatarColor}}" text="{{act.organizer.avatarText}}" size="xs"></avatar>
      <text class="act-organizer ellipsis">{{act.organizer.nickName}}</text>
      <text class="act-date">{{act.dateText}}</text>
    </view>

    <!-- 点地点直接调起地图导航，catchtap 拦住卡片本身的「进详情」 -->
    <view class="act-row" catchtap="onLocationTap">
      <text class="act-label">地点</text>
      <text class="act-location ellipsis">{{act.location}}</text>
      <text class="act-nav">导航</text>
    </view>

    <view class="act-row" wx:if="{{act.showMetrics}}">
      <text class="act-label">全程</text>
      <text class="act-metric">{{act.distance}}km</text>
      <text class="act-label gap">爬升</text>
      <text class="act-metric">{{act.elevationGain}}m</text>
    </view>

    <view class="act-foot">
      <view class="act-foot-left">
        <avatar
          wx:for="{{act.avatarList}}"
          wx:key="key"
          url="{{item.avatarUrl}}"
          color="{{item.avatarColor}}"
          text="{{item.avatarText}}"
          size="xs"
          ring="{{true}}"
        ></avatar>
        <!-- 活动类型：占原来「x/y人」的位置，报名人数不再在列表里露面。
             没头像时标签跟上面的「地点 / 全程」左对齐，有头像时再让出间距 -->
        <text class="act-type-tag {{act.avatarList.length ? 'with-avatars' : ''}}">{{act.typeName}}</text>
      </view>
      <text class="act-fee">{{act.feeText}}</text>
    </view>

    <view wx:if="{{showToolbar}}" class="act-toolbar">
      <text wx:if="{{act.auditApproved}}" class="act-status {{act.isClosed ? 'closed' : 'recruiting'}}">{{act.expired ? '已到期' : (act.isClosed ? '已关闭' : '招募中')}}</text>
      <text wx:else class="act-status {{act.auditStatus}}">{{act.auditText}}</text>
      <view class="act-toolbar-actions">
        <!-- 已通过的活动可以随时改内容，改完服务端会重新置为待审核；
             已到期的活动服务端会拒绝修改（改完也不会再展示），这里不给入口。
             未通过的活动走卡片下方的驳回原因 +「修改后重新提交」，不重复给入口 -->
        <view wx:if="{{act.auditApproved && !act.expired}}" class="act-edit" catchtap="onEdit">
          <text>修改</text>
        </view>
        <!-- 已到期 / 集合时间已过的活动不能重新打开：展示期按发布时间算，重开也不会再出现在广场 -->
        <view wx:if="{{act.auditApproved && !act.expired && !act.startPassed}}" class="act-toggle" catchtap="onToggle">
          <text>{{act.isClosed ? '打开' : '关闭'}}</text>
        </view>
      </view>
    </view>

    <slot name="footer"></slot>
  </view>
</view>
