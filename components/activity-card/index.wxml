<view class="act-card" bindtap="onTap">
  <view class="act-cover" style="background: {{act.bg}};">
    <image
      wx:if="{{coverSrc}}"
      class="act-cover-img"
      src="{{coverSrc}}"
      mode="aspectFill"
      binderror="onCoverError"
    ></image>
    <view wx:else class="poster">
      <text class="poster-title">{{poster.title}}</text>
      <text class="poster-sub">{{poster.sub}}</text>
    </view>
    <view class="act-type"><text>{{act.typeName}}</text></view>
    <!-- 审核状态比业务状态更该被发起人看到，优先展示；但过了展示期的活动已自动关闭，按已到期展示 -->
    <view wx:if="{{!act.auditApproved && !act.expired}}" class="act-closed act-audit-{{act.auditStatus}}"><text>{{act.auditText}}</text></view>
    <!-- 展示期届满（发布满 7 天）自动关闭，与发起人主动关闭区分开 -->
    <view wx:elif="{{act.expired}}" class="act-closed"><text>已到期</text></view>
    <view wx:elif="{{act.isClosed}}" class="act-closed"><text>已关闭</text></view>
  </view>

  <view class="act-body">
    <view class="act-title-row">
      <text wx:if="{{act.showMetrics && act.difficulty}}" class="act-difficulty">{{act.difficultyText}}</text>
      <text class="tag tag-orange act-tag" wx:for="{{act.tagNames}}" wx:key="*this">{{item}}</text>
      <text class="act-title ellipsis">{{act.title}}</text>
    </view>

    <view class="act-row">
      <avatar url="{{act.organizer.avatarUrl}}" color="{{act.organizer.avatarColor}}" text="{{act.organizer.avatarText}}" size="xs"></avatar>
      <text class="act-organizer ellipsis">{{act.organizer.nickName}}</text>
      <text class="act-date">{{act.dateText}}</text>
    </view>

    <!-- 点地点直接调起地图导航，catchtap 拦住卡片本身的「进详情」 -->
    <view class="act-row" catchtap="onLocationTap">
      <text class="act-label">地点</text>
      <text class="act-location ellipsis">{{act.location}}</text>
      <text class="act-nav">导航</text>
    </view>

    <view class="act-row" wx:if="{{act.showMetrics}}">
      <text class="act-label">全程</text>
      <text class="act-metric">{{act.distance}}km</text>
      <text class="act-label gap">爬升</text>
      <text class="act-metric">{{act.elevationGain}}m</text>
    </view>

    <view class="act-foot">
      <view class="act-avatars">
        <avatar
          wx:for="{{act.avatarList}}"
          wx:key="key"
          url="{{item.avatarUrl}}"
          color="{{item.avatarColor}}"
          text="{{item.avatarText}}"
          size="xs"
          ring="{{true}}"
        ></avatar>
        <text class="act-people">{{act.peopleText}}</text>
      </view>
      <text class="act-fee">{{act.feeText}}</text>
    </view>

    <view wx:if="{{showToolbar}}" class="act-toolbar">
      <text wx:if="{{act.auditApproved}}" class="act-status {{act.isClosed ? 'closed' : 'recruiting'}}">{{act.expired ? '已到期' : (act.isClosed ? '已关闭' : '招募中')}}</text>
      <text wx:else class="act-status {{act.auditStatus}}">{{act.auditText}}</text>
      <!-- 已到期的活动不能重新打开：展示期按发布时间算，重开也不会再出现在广场 -->
      <view wx:if="{{act.auditApproved && !act.expired}}" class="act-toggle" catchtap="onToggle">
        <text>{{act.isClosed ? '打开' : '关闭'}}</text>
      </view>
    </view>

    <slot name="footer"></slot>
  </view>
</view>
