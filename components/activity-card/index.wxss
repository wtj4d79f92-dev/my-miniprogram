.act-card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.act-cover {
  position: relative;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.act-cover-img {
  width: 100%;
  height: 100%;
}

.poster {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.poster-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 700;
}

.poster-title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.poster-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.act-type {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  color: var(--text);
}

.act-closed {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(45, 55, 72, 0.65);
  color: #ffffff;
  font-size: 22rpx;
}

.act-body {
  padding: 24rpx;
}

.act-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.act-difficulty {
  flex: none;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 181, 120, 0.12);
  color: var(--brand);
  font-size: 22rpx;
}

.act-tag {
  flex: none;
  margin-right: 10rpx;
}

.act-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.act-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.act-organizer {
  flex: 1;
  margin-left: 14rpx;
  font-size: 26rpx;
  color: var(--text);
}

.act-date {
  flex: none;
  font-size: 24rpx;
  color: var(--text-sub);
}

.act-label {
  flex: none;
  width: 76rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.act-label.gap {
  margin-left: 24rpx;
}

.act-location {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
}

.act-metric {
  font-size: 24rpx;
  color: var(--text);
}

.act-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--line);
  margin-top: 6rpx;
}

.act-avatars {
  display: flex;
  align-items: center;
}

.act-avatars .avatar {
  margin-right: -12rpx;
}

.act-people {
  margin-left: 24rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.act-fee {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
}

.act-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.act-status {
  font-size: 24rpx;
}

.act-status.recruiting {
  color: var(--brand);
}

.act-status.closed {
  color: var(--text-light);
}

.act-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: 26rpx;
}
