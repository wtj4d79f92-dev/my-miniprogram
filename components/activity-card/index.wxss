.act-card {
  /* 与全局卡片同一套玻璃材质：半透明卡面 + 外圈亮边 + 内里高光 */
  background: var(--card-sheen);
  border-radius: var(--radius);
  box-shadow: var(--shadow), var(--card-inner);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.act-cover {
  position: relative;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.act-cover-img {
  width: 100%;
  height: 100%;
}

.act-closed {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(45, 55, 72, 0.65);
  color: #ffffff;
  font-size: 22rpx;
}

.act-body {
  padding: 24rpx;
}

/* 无封面活动（只有默认封面）的版式：不铺装饰图，这行只承载审核 / 关闭状态窄标签
   （活动类型已挪到卡片底部的费用行左侧） */
.act-flat-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 16rpx;
}

.act-status-flat {
  flex: none;
  padding: 4rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  line-height: 1.6;
}

/* 状态窄标签沿用角标的配色口径：审核中橙、未通过红、已关闭/已到期灰 */
.act-status-flat {
  background: rgba(45, 55, 72, 0.08);
  color: var(--text-sub);
}

.act-status-flat.tone-pending {
  background: rgba(217, 134, 0, 0.12);
  color: #d98600;
}

.act-status-flat.tone-rejected {
  background: rgba(227, 77, 89, 0.12);
  color: #e34d59;
}

.act-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.act-difficulty {
  flex: none;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 181, 120, 0.12);
  color: var(--brand);
  font-size: 22rpx;
}

.act-tag {
  flex: none;
  margin-right: 10rpx;
}

.act-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.act-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.act-organizer {
  flex: 1;
  margin-left: 14rpx;
  font-size: 26rpx;
  color: var(--text);
}

.act-date {
  flex: none;
  font-size: 24rpx;
  color: var(--text-sub);
}

.act-label {
  flex: none;
  width: 76rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.act-label.gap {
  margin-left: 24rpx;
}

.act-location {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
}

/* 地点可点：点一下就用地图软件导航，和详情页同一套行为 */
.act-nav {
  flex: none;
  margin-left: 12rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  line-height: 1.7;
  color: var(--brand);
  background: var(--brand-soft);
}

.act-metric {
  font-size: 24rpx;
  color: var(--text);
}

.act-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--line);
  margin-top: 6rpx;
}

/* 底部左侧：有报名时先排成员头像堆叠，再跟活动类型标签；没人报名时只剩类型标签 */
.act-foot-left {
  display: flex;
  align-items: center;
}

.act-foot-left .avatar {
  margin-right: -12rpx;
}

/* 活动类型：从卡片顶部挪到底部，占原来「x/y人」的位置。
   默认左对齐（跟上面的「地点 / 全程」同一条竖线），只有前面排了成员头像时才让出间距 */
.act-type-tag {
  flex: none;
  padding: 4rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  line-height: 1.5;
  background: var(--brand-soft);
  color: var(--brand);
}

.act-type-tag.with-avatars {
  margin-left: 36rpx;
}

.act-fee {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
}

.act-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.act-status {
  font-size: 24rpx;
}

.act-status.recruiting {
  color: var(--brand);
}

.act-status.closed {
  color: var(--text-light);
}

.act-status.pending {
  color: #d98600;
}

.act-status.rejected {
  color: #e34d59;
}

/* 工具条右侧的按钮组：状态文案在左，操作按钮靠右依次排开 */
.act-toolbar-actions {
  display: flex;
  align-items: center;
}

/* 「修改」与「打开 / 关闭」同尺寸的次要按钮，主色描边；改完要重新送审，不能跟状态文案抢视线 */
.act-edit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 60rpx;
  margin-right: 16rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: 26rpx;
}

/* 审核中 / 未通过时封面右上角的角标：与「已关闭」共用样式，仅换底色 */
.act-audit-pending {
  background: rgba(217, 134, 0, 0.9);
}

.act-audit-rejected {
  background: rgba(227, 77, 89, 0.9);
}

.act-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: 26rpx;
}
