<view class="empty">
  <text class="empty-icon">{{icon}}</text>
  <text class="empty-text">{{text}}</text>
  <view wx:if="{{buttonText}}" class="btn-primary empty-btn" bindtap="onAction" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">
    <text>{{buttonText}}</text>
  </view>
</view>
