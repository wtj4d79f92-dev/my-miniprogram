.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  overflow: hidden;
  flex: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}

.avatar-xs {
  width: 40rpx;
  height: 40rpx;
}

.avatar-xs .avatar-text {
  font-size: 20rpx;
}

.avatar-sm {
  width: 52rpx;
  height: 52rpx;
}

.avatar-sm .avatar-text {
  font-size: 24rpx;
}

.avatar-md {
  width: 76rpx;
  height: 76rpx;
}

.avatar-md .avatar-text {
  font-size: 32rpx;
}

.avatar-lg {
  width: 128rpx;
  height: 128rpx;
}

.avatar-lg .avatar-text {
  font-size: 48rpx;
}

.avatar-ring {
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
}
