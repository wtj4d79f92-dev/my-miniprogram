.locate-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
}

.locate-left {
  display: flex;
  align-items: center;
}

.locate-icon {
  font-size: 28rpx;
}

.locate-city {
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.locate-tips {
  margin-left: 12rpx;
  font-size: 22rpx;
  /* 直接落在页面底色上，灰字读不清 */
  color: var(--text-on-bg-sub);
}

.locate-switch {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
}

.search-entry {
  display: flex;
  align-items: center;
  height: 84rpx;
  margin-top: 20rpx;
  padding: 0 10rpx 0 26rpx;
  /* 搜索框跟横幅、卡片同一个圆角，别单独做成胶囊 */
  border-radius: var(--radius);
  background: var(--card-sheen);
  box-shadow: var(--shadow), var(--card-inner);
}

.search-icon {
  font-size: 26rpx;
}

.search-placeholder {
  flex: 1;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--text-light);
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 34rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  color: #ffffff;
  font-size: 26rpx;
}

.banner {
  height: 280rpx;
  margin-top: 24rpx;
  /* 横幅也按卡片看：和骨架态一样带悬浮投影，圆角由 .banner-item 裁出来 */
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.banner-item {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 0 40rpx;
  border-radius: var(--radius);
  box-sizing: border-box;
  /* 配图铺满整条横幅，圆角要靠容器裁掉 */
  overflow: hidden;
}

/* 横幅配图：压在渐变背景之上、文案之下 */
.banner-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 照片深浅不可控，左侧压一层黑色蒙层保证白色标题始终读得清 */
.banner-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.12) 100%);
}

/* 绝对定位的图片 / 蒙层会盖住静态文案，这里把文案抬到蒙层之上 */
.banner-emoji,
.banner-title,
.banner-sub {
  position: relative;
}

.banner-emoji {
  font-size: 44rpx;
}

.banner-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 12rpx 8rpx;
}

.type-item {
  /* 百分比宽度在部分机型会被向上取整，5×20% 溢出导致第 5 个换行，这里留 1px 余量 */
  flex: 0 0 calc(20% - 1px);
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.type-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  overflow: hidden;
  border-radius: var(--radius);
  font-size: 40rpx;
}

.type-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fallback-tip {
  margin: 24rpx 0 4rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-sm);
  background: #fff7e8;
  color: #b26a00;
  font-size: 24rpx;
}

/* 朋友圈单页模式：顶部说明，跳转类操作在单页模式下被微信禁用 */
.single-page-tip {
  margin: 16rpx 0 0;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-soft);
  color: var(--text-sub);
  font-size: 24rpx;
  line-height: 1.5;
}

.footer {
  padding: 48rpx 0 20rpx;
  text-align: center;
}

.footer text {
  font-size: 22rpx;
  color: var(--text-on-bg-sub);
}

.fab {
  position: fixed;
  left: 50%;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 34rpx;
  border-radius: var(--radius-pill);
  transform: translateX(-50%);
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  box-shadow: 0 12rpx 32rpx rgba(0, 181, 120, 0.35);
  color: #ffffff;
  transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 按下：保持水平居中，再往下沉一点 */
.fab-press {
  transform: translateX(-50%) translateY(6rpx) scale(0.95);
  transition: transform 90ms cubic-bezier(0.4, 0, 1, 1);
}

.fab-plus {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.fab-text {
  font-size: 28rpx;
  font-weight: 600;
}

/* ------------------------------ 首屏骨架 ------------------------------ */
/* 没有任何内容可显示时（首次打开、没有本地快照）先占位，形状与真实卡片一致，加载完自然替换 */
.banner-skeleton,
.skeleton-card {
  background: var(--card-sheen);
  box-shadow: var(--shadow);
}

.banner-skeleton {
  border-radius: var(--radius);
}

.skeleton-card {
  overflow: hidden;
  border-radius: var(--radius);
  margin-bottom: 24rpx;
}

.skeleton-cover {
  height: 280rpx;
  border-radius: var(--radius);
  background: #e6ecf2;
}

.skeleton-body {
  padding: 24rpx;
}

.skeleton-line {
  height: 24rpx;
  margin-top: 20rpx;
  border-radius: var(--radius-pill);
  background: #e6ecf2;
}

.skeleton-line:first-child {
  margin-top: 0;
}

.skeleton-title {
  width: 180rpx;
  height: 30rpx;
  margin: 0;
}

.skeleton-line-lg {
  width: 68%;
  height: 32rpx;
}

.skeleton-line-sm {
  width: 40%;
}

.banner-skeleton,
.skeleton-cover,
.skeleton-line {
  animation: skeleton-breathe 1.2s ease-in-out infinite;
}

@keyframes skeleton-breathe {
  0% {
    opacity: 1;
  }

  50% {
    opacity: 0.72;
  }

  100% {
    opacity: 1;
  }
}
