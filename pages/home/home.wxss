.locate-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
}

.locate-left {
  display: flex;
  align-items: center;
}

.locate-icon {
  font-size: 28rpx;
}

.locate-city {
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.locate-tips {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.locate-switch {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
}

.search-entry {
  display: flex;
  align-items: center;
  height: 84rpx;
  margin-top: 20rpx;
  padding: 0 10rpx 0 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: var(--shadow);
}

.search-icon {
  font-size: 26rpx;
}

.search-placeholder {
  flex: 1;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--text-light);
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  color: #ffffff;
  font-size: 26rpx;
}

.banner {
  height: 280rpx;
  margin-top: 24rpx;
}

.banner-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 0 40rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.banner-emoji {
  font-size: 44rpx;
}

.banner-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 12rpx 8rpx;
}

.type-item {
  /* 百分比宽度在部分机型会被向上取整，5×20% 溢出导致第 5 个换行，这里留 1px 余量 */
  flex: 0 0 calc(20% - 1px);
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.type-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  overflow: hidden;
  border-radius: 28rpx;
  font-size: 40rpx;
}

.type-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fallback-tip {
  margin: 24rpx 0 4rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #fff7e8;
  color: #b26a00;
  font-size: 24rpx;
}

.footer {
  padding: 48rpx 0 20rpx;
  text-align: center;
}

.footer text {
  font-size: 22rpx;
  color: var(--text-light);
}

.fab {
  position: fixed;
  left: 50%;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  box-shadow: 0 12rpx 32rpx rgba(0, 181, 120, 0.35);
  color: #ffffff;
}

.fab-plus {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.fab-text {
  font-size: 28rpx;
  font-weight: 600;
}
