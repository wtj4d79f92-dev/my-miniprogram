<view class="page tab-page">
  <!-- 单页模式下微信自带固定顶部导航栏，页面里的 navigation-bar 属于被禁用组件，这里不再渲染 -->
  <navigation-bar wx:if="{{!singlePage}}" title="{{texts.appName}}" back="{{false}}" color="#2D3748" background="#BFAF92"></navigation-bar>

  <scroll-view
    class="page-scroll tab-page-scroll"
    scroll-y
    enhanced="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="scroll-body">
      <!-- 单页模式下跳转（搜索 / 卡片 / 发布）都被微信禁用，如实说明能力范围，不做诱导点击 -->
      <view wx:if="{{singlePage}}" class="single-page-tip">
        <text>朋友圈浏览模式仅展示活动信息，搜索、报名需在小程序内操作</text>
      </view>

      <!-- 定位与切换城市合并成一个胶囊：点开就是城市选择弹层（重新定位在弹层里） -->
      <view class="locate-bar">
        <view class="city-pill" bindtap="openCityPicker" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">
          <text class="locate-icon">📍</text>
          <text class="city-pill-name">{{locationDenied ? '定位未开启' : cityLabel}}</text>
          <text class="city-pill-arrow">▾</text>
        </view>
      </view>

      <!-- 首页跑马灯：文案统一在 utils/dict.js 的 homeMarqueeTexts 中调整 -->
      <view wx:if="{{homeMarqueeTexts.length}}" class="home-marquee" aria-label="{{homeMarqueeTexts[0]}}">
        <image class="home-marquee-icon" src="{{marqueeIcon}}" mode="aspectFit" />
        <view class="home-marquee-window">
          <!-- 多条文案：每条向上轮播展示 -->
          <swiper
            wx:if="{{homeMarqueeHasMultiple}}"
            class="home-marquee-swiper"
            vertical="{{true}}"
            autoplay="{{true}}"
            circular="{{true}}"
            interval="3000"
            duration="500"
          >
            <swiper-item wx:for="{{homeMarqueeTexts}}" wx:key="*this">
              <view class="home-marquee-slide">
                <text class="home-marquee-vertical-text">{{item}}</text>
              </view>
            </swiper-item>
          </swiper>
          <!-- 单条文案：保留原来的左右循环滚动 -->
          <view wx:else class="home-marquee-horizontal">
            <view class="home-marquee-track">
              <!-- 文案渲染两遍，滚动到一半时无缝回到起点 -->
              <view class="home-marquee-group" wx:for="{{[0, 1]}}" wx:key="*this">
                <text class="home-marquee-text">{{homeMarqueeTexts[0]}}</text>
                <text class="home-marquee-dot">·</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 横幅轮播 -->
      <!-- 首次打开且没有本地快照时，先占住横幅高度，避免页面从空白长出来 -->
      <view wx:if="{{loading && !banners.length}}" class="banner banner-skeleton"></view>
      <swiper
        wx:if="{{banners.length}}"
        class="banner"
        autoplay="{{true}}"
        interval="4000"
        circular="{{true}}"
        indicator-dots="{{true}}"
        indicator-color="rgba(255,255,255,0.6)"
        indicator-active-color="#00B578"
      >
        <swiper-item wx:for="{{banners}}" wx:key="_id">
          <!-- 有配图时整条横幅铺图（imageUrl 是云函数换来的临时链接，image 是后台填的原值），没配图就是原来的渐变 -->
          <!-- 横幅是 swiper 的滑动项，按下会被当成拖拽，不做按压下沉，免得和滑动打架 -->
          <view class="banner-item" style="background: {{item.bg}};" data-action="{{item.action}}" bindtap="onBannerTap">
            <image class="banner-image" wx:if="{{item.imageUrl || item.image}}" src="{{item.imageUrl || item.image}}" mode="aspectFill" />
            <view class="banner-mask" wx:if="{{item.imageUrl || item.image}}"></view>
            <text class="banner-emoji" wx:if="{{!(item.imageUrl || item.image)}}">{{item.emoji}}</text>
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-sub">{{item.subtitle}}</text>
          </view>
        </swiper-item>
      </swiper>

      <!-- 户外玩法 -->
      <view class="section-head">
        <text class="section-title">发现户外玩法</text>
      </view>
      <view class="type-grid card">
        <view
          class="type-item"
          wx:for="{{typeGrid}}"
          wx:key="key"
          data-type="{{item.key}}"
          bindtap="onTypeTap"
          hover-class="btn-press"
          hover-start-time="0"
          hover-stay-time="80"
        >
          <!-- 图标来自 utils/type-icons.js：默认是统一线性图标，换了吉祥物的类型是自带底色的位图（铺满整格） -->
          <view class="type-icon">
            <image
              wx:if="{{!iconErrorMap[index]}}"
              class="type-icon-img {{item.iconFill ? 'is-fill' : ''}}"
              src="{{item.icon}}"
              mode="aspectFit"
              data-index="{{index}}"
              binderror="onTypeIconError"
            />
            <!-- 图标没解出来时退回 emoji，格子不空着 -->
            <text wx:else class="type-icon-emoji">{{item.emoji}}</text>
          </view>
          <text class="type-name">{{item.name}}</text>
        </view>
      </view>

      <!-- 回退提示条 -->
      <view wx:if="{{fallbackTip}}" class="fallback-tip">
        <text>{{fallbackTip}}</text>
      </view>

      <!-- 首屏骨架：没有任何内容可显示时先占位，加载完由下面的卡片自然替换 -->
      <block wx:if="{{loading && !hotList.length && !newestList.length}}">
        <view class="section-head"><view class="skeleton-line skeleton-title"></view></view>
        <view class="skeleton-card" wx:for="{{[0, 1, 2]}}" wx:key="*this">
          <view class="skeleton-cover"></view>
          <view class="skeleton-body">
            <view class="skeleton-line skeleton-line-lg"></view>
            <view class="skeleton-line"></view>
            <view class="skeleton-line skeleton-line-sm"></view>
          </view>
        </view>
      </block>

      <!-- 热门组队 -->
      <view class="section-head" wx:if="{{hotList.length}}">
        <text class="section-title">热门组队</text>
        <text class="section-more" data-type="" bindtap="goSquare">更多 ›</text>
      </view>
      <activity-card
        wx:for="{{hotList}}"
        wx:key="id"
        act="{{item}}"
        bindtapcard="onCardTap"
      ></activity-card>

      <!-- 最新发布 -->
      <view class="section-head" wx:if="{{newestList.length}}">
        <text class="section-title">最新发布</text>
      </view>
      <activity-card
        wx:for="{{newestList}}"
        wx:key="id"
        act="{{item}}"
        bindtapcard="onCardTap"
      ></activity-card>

      <empty-state wx:if="{{!loading && !hotList.length && !newestList.length}}" icon="🏕" text="附近还没有活动，换个城市或发布一个吧"></empty-state>

      <view class="footer"><text>{{texts.footer}}</text></view>
    </view>
  </scroll-view>

  <!-- 发布要登录态与页面跳转，单页模式下都不可用 -->
  <view class="fab" wx:if="{{!singlePage}}" bindtap="goPublish" hover-class="fab-press" hover-start-time="0" hover-stay-time="80">
    <text class="fab-plus">＋</text>
    <text class="fab-text">发布</text>
  </view>

  <city-picker id="city-picker" city="{{city}}" bindchange="onCityChange" bindlocate="onLocateTap"></city-picker>
  <login-modal id="login-modal" bindlogin="onLogin"></login-modal>
</view>
