.feedback-card {
  margin-top: 20rpx;
}

.feedback-input {
  width: 100%;
  height: 380rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
}

.feedback-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-light);
}

.submit-btn {
  margin-top: 40rpx;
  width: 100%;
}

.feedback-footer {
  display: block;
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.7;
}
