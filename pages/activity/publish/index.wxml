<view class="page publish-page">
  <navigation-bar title="发起活动" color="#2D3748" background="#FFFFFF"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y>
    <view class="scroll-body">
      <!-- 封面 -->
      <view class="card">
        <view class="form-head"><text class="form-title">活动封面</text><text class="form-sub">选填，缺省使用默认海报</text></view>
        <view class="cover-upload">
          <view wx:if="{{form.cover}}" class="cover-preview">
            <image class="cover-img" src="{{form.cover}}" mode="aspectFill"></image>
            <view class="cover-remove" catchtap="removeCover"><text>✕</text></view>
          </view>
          <view wx:else class="cover-add" bindtap="chooseCover">
            <text class="cover-add-icon">＋</text>
            <text class="cover-add-text">上传封面</text>
          </view>
        </view>
      </view>

      <!-- 活动类型 -->
      <view class="card">
        <view class="form-head"><text class="form-title">活动类型 <text class="required">*</text></text></view>
        <view class="type-grid">
          <view
            class="type-item {{form.type === item.key ? 'active' : ''}}"
            wx:for="{{typeGrid}}"
            wx:key="key"
            data-type="{{item.key}}"
            bindtap="onTypeTap"
          >
            <view class="type-icon" style="background: {{item.color}}33;">
              <text>{{item.emoji}}</text>
            </view>
            <text class="type-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 基础信息 -->
      <view class="card">
        <view class="form-row">
          <text class="form-label">活动标题 <text class="required">*</text></text>
          <input
            class="form-input"
            value="{{form.title}}"
            maxlength="30"
            placeholder="一句话说清活动内容"
            bindinput="onTitleInput"
          />
        </view>
        <text wx:if="{{errors.title}}" class="form-error">{{errors.title}}</text>

        <view class="form-row" wx:if="{{showTags}}">
          <text class="form-label">活动标签</text>
          <view class="tag-select">
            <view
              class="tag-option {{item.active ? 'active' : ''}}"
              wx:for="{{tagOptions}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="toggleTag"
            >{{item.name}}</view>
          </view>
        </view>

        <view class="form-row">
          <text class="form-label">集合时间 <text class="required">*</text></text>
          <view class="form-picker" data-field="startTime" bindtap="openCalendar">
            <text>{{startLabel || '请选择'}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
        <text wx:if="{{errors.startTime}}" class="form-error">{{errors.startTime}}</text>

        <view class="form-row">
          <text class="form-label">返程时间 <text class="required">*</text></text>
          <view class="form-picker" bindtap="openCalendar" data-field="endTime">
            <text>{{endLabel || '请选择'}}</text>
            <text class="form-arrow">›</text>
          </view>
        </view>
        <text wx:if="{{errors.endTime}}" class="form-error">{{errors.endTime}}</text>

        <view class="form-row column">
          <text class="form-label">集合地点 <text class="required">*</text></text>
          <view class="location-row">
            <input
              class="form-input"
              value="{{form.location}}"
              maxlength="50"
              placeholder="填写集合地点，或地图选点"
              bindinput="onLocationInput"
            />
            <view class="location-btn" bindtap="chooseLocation"><text>地图</text></view>
          </view>
        </view>
        <text wx:if="{{errors.location}}" class="form-error">{{errors.location}}</text>
      </view>

      <!-- 强度指标 -->
      <view class="card" wx:if="{{showMetrics}}">
        <view class="form-head"><text class="form-title">路线强度</text></view>
        <view class="form-row">
          <text class="form-label">活动难度</text>
          <picker
            mode="selector"
            range="{{difficultyOptions}}"
            range-key="label"
            value="{{difficultyIndex}}"
            bindchange="onDifficultyChange"
          >
            <view class="form-picker"><text>{{difficultyLabel}}</text><text class="form-arrow">›</text></view>
          </picker>
        </view>
        <view class="form-row">
          <text class="form-label">全程长度 <text class="required">*</text></text>
          <input class="form-input" type="digit" value="{{form.distance}}" placeholder="单位 km" bindinput="onDistanceInput" />
        </view>
        <text wx:if="{{errors.distance}}" class="form-error">{{errors.distance}}</text>
        <view class="form-row">
          <text class="form-label">累计爬升 <text class="required">*</text></text>
          <input class="form-input" type="digit" value="{{form.elevationGain}}" placeholder="单位 m" bindinput="onElevationInput" />
        </view>
        <text wx:if="{{errors.elevationGain}}" class="form-error">{{errors.elevationGain}}</text>
      </view>

      <!-- 费用与人数 -->
      <view class="card">
        <view class="form-row">
          <text class="form-label">费用模式 <text class="required">*</text></text>
          <view class="fee-switch">
            <view class="fee-option {{form.feeMode === 'aa' ? 'active' : ''}}" data-mode="aa" bindtap="setFeeMode"><text>AA制</text></view>
            <view class="fee-option {{form.feeMode === 'fixed' ? 'active' : ''}}" data-mode="fixed" bindtap="setFeeMode"><text>非AA制</text></view>
          </view>
        </view>
        <view class="form-row" wx:if="{{form.feeMode === 'fixed'}}">
          <text class="form-label">人均费用 <text class="required">*</text></text>
          <input class="form-input" type="digit" value="{{form.fee}}" placeholder="单位 元" bindinput="onFeeInput" />
        </view>
        <text wx:if="{{errors.fee}}" class="form-error">{{errors.fee}}</text>
        <view class="form-row">
          <text class="form-label">人数上限 <text class="required">*</text></text>
          <view class="stepper">
            <view class="stepper-btn" bindtap="minusPeople"><text>−</text></view>
            <text class="stepper-value">{{form.maxPeople}}</text>
            <view class="stepper-btn" bindtap="plusPeople"><text>＋</text></view>
          </view>
        </view>
      </view>

      <!-- 活动群二维码 -->
      <view class="card">
        <view class="form-head"><text class="form-title">活动群二维码 <text class="required">*</text></text><text class="form-sub">仅从相册选择</text></view>
        <view class="qr-upload">
          <view wx:if="{{form.groupQrCode}}" class="qr-preview">
            <image class="qr-img" src="{{form.groupQrCode}}" mode="aspectFit"></image>
            <view class="qr-actions">
              <view class="qr-action" bindtap="chooseGroupQr"><text>重新上传</text></view>
              <view class="qr-action danger" bindtap="removeGroupQr"><text>删除</text></view>
            </view>
          </view>
          <view wx:else class="qr-add" bindtap="chooseGroupQr">
            <text class="cover-add-icon">＋</text>
            <text class="cover-add-text">上传二维码</text>
          </view>
        </view>
        <text wx:if="{{errors.groupQrCode}}" class="form-error qr-error">{{errors.groupQrCode}}</text>
      </view>

      <!-- 活动介绍 -->
      <view class="card">
        <view class="form-head">
          <text class="form-title">活动介绍</text>
          <text class="form-sub">{{descCount}}/500</text>
        </view>
        <textarea
          class="desc-input"
          value="{{form.desc}}"
          maxlength="500"
          placeholder="路线亮点、装备要求、注意事项等"
          bindinput="onDescInput"
        />
      </view>

      <!-- 发布协议 -->
      <view class="agree-row">
        <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree"><text wx:if="{{agreed}}">✓</text></view>
        <text class="agree-text" bindtap="toggleAgree">我已阅读并同意</text>
        <text class="agree-link" catchtap="openPublishAgreement">《活动发布免责协议》</text>
      </view>
      <text wx:if="{{errors.agreement}}" class="form-error agree-error">{{errors.agreement}}</text>
    </view>
  </scroll-view>

  <view class="submit-bar">
    <view class="btn-primary submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
      <text>{{submitting ? '发布中…' : '发布活动'}}</text>
    </view>
  </view>

  <calendar-picker id="calendar-picker" bindconfirm="onDateConfirm"></calendar-picker>
  <agreement-modal id="agreement-modal" bindagree="onAgreementAgree"></agreement-modal>
  <login-modal id="login-modal" bindlogin="onLogin"></login-modal>
</view>
