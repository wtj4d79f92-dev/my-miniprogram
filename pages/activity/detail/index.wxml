<view class="page detail-page {{singlePage ? 'single-page' : ''}}">
  <!-- 单页模式下微信自带固定顶部导航栏，页面里的 navigation-bar 属于被禁用组件，这里不再渲染 -->
  <!-- back-fallback：分享卡片 / 海报小程序码直达详情时，详情页是页面栈里的第一页，
       返回箭头按 back 调 navigateBack 会静默失败，这里约定回落到广场 -->
  <navigation-bar
    wx:if="{{!singlePage}}"
    title="活动详情"
    back-fallback="/pages/square/index"
    color="#2D3748"
    background="#FFFFFF"
  ></navigation-bar>

  <!-- 活动不存在：接口正常返回，但活动确实不可见（未过审 / 已删除 / 被下架） -->
  <view wx:if="{{notFound && !loading}}" class="not-found">
    <text class="not-found-icon">🧭</text>
    <text class="not-found-text">活动不存在或已下架</text>
    <!-- 单页模式下页面不能跳转，「返回」交给微信左上角的关闭按钮 -->
    <view wx:if="{{!singlePage}}" class="btn-primary not-found-btn" bindtap="goBack"><text>返回</text></view>
  </view>

  <!-- 加载失败：网络 / 权限问题（例如朋友圈单页模式下云开发没开启未登录访问），可以重试 -->
  <view wx:elif="{{loadError && !loading}}" class="not-found">
    <text class="not-found-icon">📡</text>
    <text class="not-found-text">{{loadError}}</text>
    <view class="btn-primary not-found-btn" bindtap="retryLoad"><text>重新加载</text></view>
  </view>

  <block wx:else>
    <scroll-view class="page-scroll" scroll-y>
      <view class="detail-body" wx:if="{{activity}}">
        <!-- 顶部封面 -->
        <view class="cover" style="background: {{activity.coverGradient}};">
          <image
            wx:if="{{activity.coverSrc}}"
            class="cover-img"
            src="{{activity.coverSrc}}"
            mode="aspectFill"
            binderror="onCoverError"
          ></image>
          <view wx:else class="cover-poster">
            <text class="cover-title">{{poster.title}}</text>
            <text class="cover-sub">{{poster.sub}}</text>
          </view>
          <view class="cover-type"><text>{{activity.typeName}}</text></view>
        </view>

        <!-- 审核状态：只有发起人自己能看到未过审的活动，所以这条提示只对发起人出现 -->
        <!-- 已到期的活动不再展示「审核中」提示（审核中的过期活动已由定时任务自动关闭）；驳回原因继续展示 -->
        <view
          wx:if="{{!activity.auditApproved && (activity.auditRejected || !activity.expired)}}"
          class="audit-banner {{activity.auditStatus}}"
        >
          <text class="audit-banner-title">{{activity.auditPending ? '活动审核中' : '审核未通过'}}</text>
          <!-- 只说「审核中」：机审还是人工复核属于平台内部流程，不对发起人区分 -->
          <text class="audit-banner-desc" wx:if="{{activity.auditPending}}">
            已提交审核，通过后将展示在广场，审核期间仅你自己可见。
          </text>
          <!-- 驳回原因写成平级判断：用 wx:else 会跟上面那条审核中提示配对，审核中时反而多出一行空原因 -->
          <text class="audit-banner-desc" wx:if="{{!activity.auditPending}}">
            未通过原因：{{activity.auditReason}}
          </text>
        </view>

        <!-- 主体信息 -->
        <view class="card main-card">
          <view class="title-row">
            <text wx:if="{{activity.showMetrics && activity.difficulty}}" class="difficulty">{{activity.difficultyText}}</text>
            <text class="tag tag-orange title-tag" wx:for="{{activity.tagNames}}" wx:key="*this">{{item}}</text>
            <text class="detail-title">{{activity.title}}</text>
          </view>

          <view class="organizer-row">
            <avatar
              url="{{activity.organizer.avatarUrl}}"
              color="{{activity.organizer.avatarColor}}"
              text="{{activity.organizer.avatarText}}"
              size="sm"
            ></avatar>
            <text class="organizer-name ellipsis">{{activity.organizer.nickName}}</text>
            <text class="tag tag-brand">发起人</text>
            <text class="organizer-date">{{activity.startLabel}}</text>
          </view>

          <!-- 点击地点调起地图：选中地图软件后地址会一起带过去导航 -->
          <view class="field-row field-row-tap" bindtap="onLocationTap">
            <text class="field-label">地点</text>
            <text class="field-value">{{activity.location}}</text>
            <text class="field-nav">导航 ›</text>
          </view>

          <view class="field-row" wx:if="{{activity.showMetrics && activity.hasDistance}}">
            <text class="field-label">全程</text>
            <text class="field-value">{{activity.distance}} km</text>
          </view>
          <view class="field-row" wx:if="{{activity.showMetrics && activity.hasElevationGain}}">
            <text class="field-label">爬升</text>
            <text class="field-value">{{activity.elevationGain}} m</text>
          </view>

          <view class="divider info-divider"></view>

          <view class="info-grid">
            <view class="info-item">
              <text class="info-label">集合时间</text>
              <text class="info-value">{{activity.startLabel}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">返程时间</text>
              <text class="info-value">{{activity.endLabel || '待定'}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">费用</text>
              <text class="info-value">{{activity.feeText}}</text>
              <text class="info-note">平台不收取任何资金，费用由发起人与参与者自行协商</text>
            </view>
            <view class="info-item">
              <text class="info-label">人数</text>
              <text class="info-value">{{activity.joinedCount}} / {{activity.maxPeople}} 人</text>
            </view>
            <view class="info-item">
              <text class="info-label">状态</text>
              <text class="status {{activity.isClosed ? 'closed' : (activity.isFull ? 'full' : 'recruiting')}}">{{statusText}}</text>
            </view>
          </view>
        </view>

        <!-- 行前信息：报名后在小程序内闭环。地点导航 / 集合时间 / 同行伙伴都在这儿看，
             活动群是选填的补充沟通渠道，入口在底部操作区的「查看二维码」（用户主动点） -->
        <view wx:if="{{!isOrganizer && activity.joined && !singlePage}}" class="card">
          <view class="section-head inner-head">
            <text class="section-title">行前信息</text>
          </view>
          <text class="prep-sub">你的报名已生效，以下信息在小程序内就能看到</text>
          <view class="prep-row prep-row-tap" bindtap="onLocationTap">
            <text class="prep-label">集合地点</text>
            <text class="prep-value ellipsis">{{activity.location}}</text>
            <text class="prep-nav">导航 ›</text>
          </view>
          <view class="prep-row">
            <text class="prep-label">集合时间</text>
            <text class="prep-value">{{activity.startLabel}}</text>
          </view>
          <view class="prep-row">
            <text class="prep-label">同行伙伴</text>
            <text class="prep-value">{{activity.joinedCount}} 人已报名，名单见下方</text>
          </view>
          <text class="prep-note">{{activity.groupQrCode ? '退出活动、查看同行成员都在本页完成；想进活动群时，点底部「查看二维码」。' : '退出活动、查看同行成员都在本页完成，不需要额外渠道。'}}</text>
        </view>

        <!-- 已报名 -->
        <view class="card">
          <view class="section-head inner-head">
            <text class="section-title">已报名 ({{activity.joinedCount}})</text>
          </view>
          <view wx:if="{{activity.avatarList.length}}" class="member-list">
            <view class="member" wx:for="{{activity.avatarList}}" wx:key="key">
              <avatar url="{{item.avatarUrl}}" color="{{item.avatarColor}}" text="{{item.avatarText}}" size="sm"></avatar>
              <text class="member-name ellipsis">{{item.nickName}}</text>
            </view>
          </view>
          <text wx:else class="member-empty">还没有人报名，快来抢沙发</text>
        </view>

        <!-- 活动介绍 -->
        <view class="card">
          <view class="section-head inner-head">
            <text class="section-title">活动介绍</text>
          </view>
          <text class="desc-text">{{activity.descText}}</text>
        </view>

        <!-- 活动留言：只有参与本活动的人（发起人 / 已报名）能看到，非参与者连卡片都不渲染。
             这是「不跳去微信群也能约上事」的站内闭环，也是 UGC —— 发言过内容安全，可删可举报 -->
        <view wx:if="{{canComment}}" class="card">
          <view class="section-head inner-head">
            <text class="section-title">活动留言</text>
            <text class="comment-sub">仅参与本活动的人可见</text>
          </view>

          <view wx:if="{{comments.length}}" class="comment-list">
            <view class="comment-item" wx:for="{{comments}}" wx:key="id">
              <avatar
                url="{{item.avatarUrl}}"
                color="{{item.avatarColor}}"
                text="{{item.avatarText}}"
                size="sm"
              ></avatar>
              <view class="comment-main">
                <view class="comment-head">
                  <text class="comment-name ellipsis">{{item.nickName}}</text>
                  <text class="comment-time">{{item.timeLabel}}</text>
                </view>
                <text class="comment-text">{{item.content}}</text>
                <view class="comment-actions">
                  <text
                    wx:if="{{item.canRemove}}"
                    class="comment-action"
                    data-comment-id="{{item.id}}"
                    bindtap="onCommentRemove"
                  >删除</text>
                  <text
                    wx:if="{{!item.isMine}}"
                    class="comment-action"
                    data-comment-id="{{item.id}}"
                    bindtap="onCommentReport"
                  >举报</text>
                </view>
              </view>
            </view>
          </view>
          <text wx:elif="{{commentsLoading}}" class="comment-empty">留言加载中…</text>
          <text wx:else class="comment-empty">还没有留言，说说集合安排、拼车或装备吧</text>

          <view class="comment-input-row">
            <input
              class="comment-input"
              value="{{commentInput}}"
              maxlength="200"
              placeholder="说点什么，只有参与活动的人能看到"
              confirm-type="send"
              bindinput="onCommentInput"
              bindconfirm="submitComment"
            />
            <view
              class="comment-send {{commentSending || !commentInput ? 'disabled' : ''}}"
              bindtap="submitComment"
            ><text>{{commentSending ? '发送中' : '发送'}}</text></view>
          </view>
          <text class="comment-tip">留言只对本活动参与者可见；涉及手机号、微信号等联系方式，请自行判断风险。</text>
        </view>

        <!-- 举报：UGC 内容需要公开的投诉入口，自己的活动不展示 -->
        <view wx:if="{{!isOrganizer && !singlePage}}" class="report-entry" bindtap="onReportTap">
          <text>举报该活动</text>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作区 -->
    <view class="action-bar" wx:if="{{activity}}">
      <!-- 单页模式没有登录态：如实说明能力范围，不做诱导点击，也不给出点了没反应的协议勾选 -->
      <view wx:if="{{singlePage}}" class="single-page-tip">
        <text>朋友圈浏览模式仅展示活动信息，报名相关操作不可用</text>
      </view>
      <view
        wx:if="{{!singlePage && !isOrganizer && !activity.joined && !activity.isClosed && !activity.isFull}}"
        class="agree-row"
        bindtap="toggleAgree"
      >
        <view class="checkbox {{agreed ? 'checked' : ''}}"><text wx:if="{{agreed}}">✓</text></view>
        <text class="agree-text">我已阅读并同意</text>
        <text class="agree-link" catchtap="openJoinAgreement">《活动风险告知与免责协议》</text>
      </view>
      <view class="action-row">
        <view wx:if="{{!singlePage}}" class="share-btn" bindtap="openSharePanel">
          <text class="share-icon">↗</text>
          <text>分享</text>
        </view>
        <!-- 已报名用户（非发起人）的主动入口：想看活动群的时候自己点，报名成功时不会自动弹出来 -->
        <view
          wx:if="{{!isOrganizer && activity.joined && activity.groupQrCode}}"
          class="qr-entry"
          bindtap="openQrModal"
        >查看二维码</view>
        <view
          class="main-btn {{mainBtn.disabled ? 'disabled' : ''}} {{mainBtn.style}}"
          bindtap="onMainTap"
        >
          <text>{{mainBtn.text}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 分享面板 -->
  <view wx:if="{{showSharePanel}}">
    <view class="mask" bindtap="closeSharePanel"></view>
    <view class="sheet">
      <view class="sheet-head">
        <text class="sheet-title">分享活动</text>
        <text class="sheet-close" bindtap="closeSharePanel">✕</text>
      </view>
      <view class="share-list">
        <button class="share-item" open-type="share">
          <text class="share-emoji">💬</text>
          <text class="share-label">微信好友</text>
        </button>
        <view class="share-item" bindtap="onTapShareTimeline">
          <text class="share-emoji">🌤</text>
          <text class="share-label">朋友圈</text>
        </view>
        <view class="share-item" bindtap="onSharePoster">
          <text class="share-emoji">🖼</text>
          <text class="share-label">生成分享图片</text>
        </view>
      </view>
      <view class="share-space"></view>
    </view>
  </view>

  <!-- 活动群二维码（选填）：已报名用户主动点开，不再是报名成功后的强制步骤 -->
  <view wx:if="{{showQrModal}}">
    <view class="mask" bindtap="closeQrModal"></view>
    <view class="dialog qr-dialog">
      <text class="qr-title">{{qrTitle}}</text>
      <view class="qr-box">
        <image
          wx:if="{{activity.qrSrc && !qrPlaceholder}}"
          class="qr-img"
          src="{{activity.qrSrc}}"
          mode="aspectFit"
          show-menu-by-longpress
          binderror="onQrError"
        ></image>
        <view wx:else class="qr-placeholder">
          <text class="qr-placeholder-text">活动二维码</text>
          <text class="qr-placeholder-tip">{{qrPlaceholderTip}}</text>
        </view>
      </view>
      <text class="qr-tip">{{qrTip}}</text>
      <text class="qr-sub-tip">需要时可直接长按识别，或保存后分享给同行伙伴</text>
      <view class="btn-primary qr-btn" bindtap="closeQrModal"><text>完成</text></view>
    </view>
  </view>

  <agreement-modal
    id="agreement-modal"
    bindagree="onAgreementAgree"
    bindclose="onAgreementClose"
  ></agreement-modal>
  <poster-modal id="poster-modal"></poster-modal>
  <login-modal id="login-modal" bindlogin="onLogin"></login-modal>
</view>
