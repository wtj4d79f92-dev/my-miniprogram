<view class="page detail-page">
  <navigation-bar title="活动详情" color="#2D3748" background="#FFFFFF"></navigation-bar>

  <!-- 活动不存在 -->
  <view wx:if="{{notFound && !loading}}" class="not-found">
    <text class="not-found-icon">🧭</text>
    <text class="not-found-text">活动不存在或已下架</text>
    <view class="btn-primary not-found-btn" bindtap="goBack"><text>返回</text></view>
  </view>

  <block wx:else>
    <scroll-view class="page-scroll" scroll-y>
      <view class="detail-body" wx:if="{{activity}}">
        <!-- 顶部封面 -->
        <view class="cover" style="background: {{activity.coverGradient}};">
          <image
            wx:if="{{activity.coverSrc}}"
            class="cover-img"
            src="{{activity.coverSrc}}"
            mode="aspectFill"
            binderror="onCoverError"
          ></image>
          <view wx:else class="cover-poster">
            <text class="cover-title">{{poster.title}}</text>
            <text class="cover-sub">{{poster.sub}}</text>
          </view>
          <view class="cover-type"><text>{{activity.typeName}}</text></view>
        </view>

        <!-- 审核状态：只有发起人自己能看到未过审的活动，所以这条提示只对发起人出现 -->
        <view wx:if="{{!activity.auditApproved}}" class="audit-banner {{activity.auditStatus}}">
          <text class="audit-banner-title">{{activity.auditPending ? '活动审核中' : '审核未通过'}}</text>
          <!-- 只说「审核中」：机审还是人工复核属于平台内部流程，不对发起人区分 -->
          <text class="audit-banner-desc" wx:if="{{activity.auditPending}}">
            已提交审核，通过后将展示在广场，审核期间仅你自己可见。
          </text>
          <!-- 驳回原因写成平级判断：用 wx:else 会跟上面那条审核中提示配对，审核中时反而多出一行空原因 -->
          <text class="audit-banner-desc" wx:if="{{!activity.auditPending}}">
            未通过原因：{{activity.auditReason}}
          </text>
        </view>

        <!-- 主体信息 -->
        <view class="card main-card">
          <view class="title-row">
            <text wx:if="{{activity.showMetrics && activity.difficulty}}" class="difficulty">{{activity.difficultyText}}</text>
            <text class="tag tag-orange title-tag" wx:for="{{activity.tagNames}}" wx:key="*this">{{item}}</text>
            <text class="detail-title">{{activity.title}}</text>
          </view>

          <view class="organizer-row">
            <avatar
              url="{{activity.organizer.avatarUrl}}"
              color="{{activity.organizer.avatarColor}}"
              text="{{activity.organizer.avatarText}}"
              size="sm"
            ></avatar>
            <text class="organizer-name ellipsis">{{activity.organizer.nickName}}</text>
            <text class="tag tag-brand">发起人</text>
            <text class="organizer-date">{{activity.startLabel}}</text>
          </view>

          <!-- 点击地点调起地图：选中地图软件后地址会一起带过去导航 -->
          <view class="field-row field-row-tap" bindtap="onLocationTap">
            <text class="field-label">地点</text>
            <text class="field-value">{{activity.location}}</text>
            <text class="field-nav">导航 ›</text>
          </view>

          <view class="field-row" wx:if="{{activity.showMetrics && activity.hasDistance}}">
            <text class="field-label">全程</text>
            <text class="field-value">{{activity.distance}} km</text>
          </view>
          <view class="field-row" wx:if="{{activity.showMetrics && activity.hasElevationGain}}">
            <text class="field-label">爬升</text>
            <text class="field-value">{{activity.elevationGain}} m</text>
          </view>

          <view class="divider info-divider"></view>

          <view class="info-grid">
            <view class="info-item">
              <text class="info-label">集合时间</text>
              <text class="info-value">{{activity.startLabel}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">返程时间</text>
              <text class="info-value">{{activity.endLabel || '待定'}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">费用</text>
              <text class="info-value">{{activity.feeText}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">人数</text>
              <text class="info-value">{{activity.joinedCount}} / {{activity.maxPeople}} 人</text>
            </view>
            <view class="info-item">
              <text class="info-label">状态</text>
              <text class="status {{activity.isClosed ? 'closed' : (activity.isFull ? 'full' : 'recruiting')}}">{{statusText}}</text>
            </view>
          </view>
        </view>

        <!-- 已报名 -->
        <view class="card">
          <view class="section-head inner-head">
            <text class="section-title">已报名 ({{activity.joinedCount}})</text>
          </view>
          <view wx:if="{{activity.avatarList.length}}" class="member-list">
            <view class="member" wx:for="{{activity.avatarList}}" wx:key="openid">
              <avatar url="{{item.avatarUrl}}" color="{{item.avatarColor}}" text="{{item.avatarText}}" size="sm"></avatar>
              <text class="member-name ellipsis">{{item.nickName}}</text>
            </view>
          </view>
          <text wx:else class="member-empty">还没有人报名，快来抢沙发</text>
        </view>

        <!-- 活动介绍 -->
        <view class="card">
          <view class="section-head inner-head">
            <text class="section-title">活动介绍</text>
          </view>
          <text class="desc-text">{{activity.descText}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作区 -->
    <view class="action-bar" wx:if="{{activity}}">
      <view wx:if="{{!isOrganizer && !activity.joined && !activity.isClosed && !activity.isFull}}" class="agree-row" bindtap="toggleAgree">
        <view class="checkbox {{agreed ? 'checked' : ''}}"><text wx:if="{{agreed}}">✓</text></view>
        <text class="agree-text">我已阅读并同意</text>
        <text class="agree-link" catchtap="openJoinAgreement">《活动风险告知与免责协议》</text>
      </view>
      <view class="action-row">
        <view class="share-btn" bindtap="openSharePanel">
          <text class="share-icon">↗</text>
          <text>分享</text>
        </view>
        <!-- 报名后才出现：重新查看活动群二维码，无需先退出活动 -->
        <view
          wx:if="{{!isOrganizer && activity.joined && activity.groupQrCode}}"
          class="qr-entry"
          bindtap="openQrModal"
        >查看二维码</view>
        <view
          class="main-btn {{mainBtn.disabled ? 'disabled' : ''}} {{mainBtn.style}}"
          bindtap="onMainTap"
        >
          <text>{{mainBtn.text}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 分享面板 -->
  <view wx:if="{{showSharePanel}}">
    <view class="mask" bindtap="closeSharePanel"></view>
    <view class="sheet">
      <view class="sheet-head">
        <text class="sheet-title">分享活动</text>
        <text class="sheet-close" bindtap="closeSharePanel">✕</text>
      </view>
      <view class="share-list">
        <button class="share-item" open-type="share">
          <text class="share-emoji">💬</text>
          <text class="share-label">微信好友</text>
        </button>
        <view class="share-item" bindtap="onTapShareTimeline">
          <text class="share-emoji">🌤</text>
          <text class="share-label">朋友圈</text>
        </view>
        <view class="share-item" bindtap="onSharePoster">
          <text class="share-emoji">🖼</text>
          <text class="share-label">生成分享图片</text>
        </view>
      </view>
      <view class="share-space"></view>
    </view>
  </view>

  <!-- 报名成功群二维码 -->
  <view wx:if="{{showQrModal}}">
    <view class="mask" bindtap="closeQrModal"></view>
    <view class="dialog qr-dialog">
      <text class="qr-title">{{qrTitle}}</text>
      <view class="qr-box">
        <image
          wx:if="{{activity.qrSrc && !qrPlaceholder}}"
          class="qr-img"
          src="{{activity.qrSrc}}"
          mode="aspectFit"
          show-menu-by-longpress
          binderror="onQrError"
        ></image>
        <view wx:else class="qr-placeholder">
          <text class="qr-placeholder-text">活动群二维码</text>
          <text class="qr-placeholder-tip">长按或扫码进群</text>
        </view>
      </view>
      <text class="qr-tip">长按二维码识别，或保存后分享给同行伙伴</text>
      <view class="btn-primary qr-btn" bindtap="closeQrModal"><text>完成</text></view>
    </view>
  </view>

  <agreement-modal
    id="agreement-modal"
    bindagree="onAgreementAgree"
    bindclose="onAgreementClose"
  ></agreement-modal>
  <poster-modal id="poster-modal"></poster-modal>
  <login-modal id="login-modal" bindlogin="onLogin"></login-modal>
</view>
