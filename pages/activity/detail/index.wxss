.detail-page {
  background: var(--page-bg);
}

.field-row-tap {
  align-items: center;
}

/* 地点可点击调起地图，给一个轻量的「可点」提示 */
.field-nav {
  flex: none;
  margin-left: 16rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--brand);
  background: var(--brand-soft);
}

.detail-body {
  padding: 0 24rpx;
}

.cover {
  position: relative;
  height: 380rpx;
  margin-top: 16rpx;
  border-radius: var(--radius);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 封面同样是一张浮在暖砂底色上的卡片，投影与其它卡片保持一致 */
  box-shadow: var(--shadow);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-poster {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cover-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.cover-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.cover-type {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  color: var(--text);
}

.main-card {
  margin-top: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.difficulty {
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 181, 120, 0.12);
  color: var(--brand);
  font-size: 22rpx;
}

.title-tag {
  margin-right: 10rpx;
}

.detail-title {
  width: 100%;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
}

.organizer-row {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
}

.organizer-name {
  flex: 1;
  margin: 0 14rpx;
  font-size: 28rpx;
  color: var(--text);
}

.organizer-date {
  font-size: 24rpx;
  color: var(--text-sub);
}

.info-divider {
  margin: 10rpx 0 22rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  /* 预留 1px，避免部分机型取整后每行只排得下 1 个 */
  flex: 0 0 calc(50% - 1px);
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-bottom: 22rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.info-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: var(--text);
}

/* 费用口径：平台不参与资金流转，详情页要一直能看到这句。
   独占一整行（100% 宽）才能在窄屏上也单行排完，不再折成两行 */
.info-note-wrap {
  flex: 0 0 100%;
  margin-top: -12rpx;
  margin-bottom: 18rpx;
}

.info-note {
  font-size: 20rpx;
  color: var(--text-light);
  line-height: 1.4;
  white-space: nowrap;
}

.status {
  margin-top: 6rpx;
  font-size: 28rpx;
}

.status.recruiting {
  color: var(--brand);
}

.status.full {
  color: var(--text-light);
}

.status.closed {
  color: var(--text-light);
}

/* 行前信息卡：报名后看时间 / 地点 / 费用 / 同行成员，全部在小程序内完成 */
.prep-sub {
  display: block;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.prep-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--line);
}

/* 可点的两行（导航 / 活动群）：值用主色，和纯展示行区分开 */
.prep-row-tap .prep-value {
  color: var(--brand);
}

.prep-label {
  flex: 0 0 140rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.prep-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text);
}

.prep-nav {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--brand);
}

.prep-note {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.card + .card {
  margin-top: 24rpx;
}

/* ------------------------------ 活动留言 ------------------------------ */

.comment-sub {
  font-size: 20rpx;
  color: var(--text-light);
}

.comment-list {
  display: flex;
  flex-direction: column;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.comment-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text);
}

.comment-time {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--text-light);
}

.comment-text {
  display: block;
  margin-top: 8rpx;
  /* 留言是用户输入的短文本，保留换行但不撑破卡片 */
  word-break: break-word;
  white-space: pre-wrap;
  font-size: 27rpx;
  color: var(--text);
  line-height: 1.6;
}

/* 回复：一级留言下面缩进一层，用浅底把「这是一条回复」和一级留言区分开 */
.comment-replies {
  margin: 0 0 4rpx 0;
  padding: 0 16rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
}

.comment-reply {
  border-bottom: 2rpx solid var(--line);
}

.comment-reply:last-child {
  border-bottom: none;
}

.comment-reply-to {
  color: var(--brand);
}

/* 回复态提示条：输入框上方，点「回复」后出现 */
.comment-reply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-soft);
}

.comment-reply-tip {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--brand);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comment-reply-cancel {
  flex: 0 0 auto;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 6rpx;
}

.comment-action {
  margin-left: 28rpx;
  padding: 4rpx 0;
  font-size: 22rpx;
  color: var(--text-sub);
}

.comment-empty {
  display: block;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.6;
}

.comment-input-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  background: var(--bg);
  font-size: 26rpx;
  color: var(--text);
}

.comment-send {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 76rpx;
  margin-left: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--brand);
  color: #ffffff;
  font-size: 26rpx;
}

.comment-send.disabled {
  background: #e4eaea;
  color: #a9b3b3;
}

.comment-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--text-light);
  line-height: 1.5;
}

.inner-head {
  margin: 0 0 20rpx;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
}

.member {
  /* 预留 1px，避免部分机型取整后每行只排得下 3 个 */
  flex: 0 0 calc(25% - 1px);
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 22rpx;
}

.member-name {
  width: 100%;
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-sub);
}

.member-empty {
  font-size: 26rpx;
  color: var(--text-light);
}

.desc-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text);
  white-space: pre-wrap;
}

/* 举报入口：放在内容末尾，样式弱化，避免抢主按钮的注意力 */
.report-entry {
  margin: 8rpx 0 32rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
  /* 这条落在页面底色上，灰字读不清，用偏暖的深色 */
  color: var(--text-on-bg-sub);
  text-decoration: underline;
}

/* 底部操作栏不浮动：避免挡住滚动内容，也保证按钮点击不会被内容层拦截 */
.action-bar {
  flex: none;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  /* 底部操作条与卡片、tabBar 同一套玻璃材质：半透明白，靠柔和上投影和内容分层，不描硬边 */
  background: var(--bar-bg);
  /* 上投影跟 tabBar 同一套：大范围、低透明度，别再压一道贴边的深影 */
  box-shadow: 0 -8rpx 26rpx rgba(58, 44, 24, 0.10), 0 -24rpx 64rpx rgba(58, 44, 24, 0.10);
}

.agree-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  border: 2rpx solid #cbd5d5;
  color: #ffffff;
  font-size: 22rpx;
}

.checkbox.checked {
  background: var(--brand);
  border-color: var(--brand);
}

.agree-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.agree-link {
  font-size: 24rpx;
  color: var(--brand);
}

.action-row {
  display: flex;
  align-items: center;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 88rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.share-icon {
  font-size: 32rpx;
  color: var(--brand);
}

/* 发起人的「修改」入口：与主按钮同高、同圆角的次要按钮，改完要重新送审，不该抢主按钮的视觉 */
.edit-entry {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-right: 16rpx;
  padding: 0 34rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: 28rpx;
}

/* 已报名用户的「查看二维码」入口：与退出活动同尺寸同字体，主色实底反白字并排展示。
   注意这是用户主动点的入口，报名成功时不会再自动弹码（审核按「强制引流至其他渠道」驳回过） */
.qr-entry {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--brand);
  /* 描边的退出活动按钮自带 2rpx 边框，这里补一条同色边框，两个按钮外框尺寸完全对齐 */
  border: 2rpx solid var(--brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.main-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.main-btn.disabled {
  background: #e4eaea;
  color: #a9b3b3;
}

.main-btn.outline {
  background: #ffffff;
  border: 2rpx solid var(--brand);
  color: var(--brand);
}

/* 发起人的「关闭活动」：中性次要按钮，避免与报名主按钮混淆 */
.main-btn.manage {
  background: #ffffff;
  border: 2rpx solid #cbd5d5;
  color: var(--text);
}

.not-found {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.not-found-icon {
  font-size: 90rpx;
}

.not-found-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-sub);
}

.not-found-btn {
  margin-top: 40rpx;
  padding: 0 70rpx;
}

/* 朋友圈单页模式：顶部导航栏与底部操作栏都由微信渲染，页面被挤压后不再有底部安全区 */
.detail-page.single-page .action-bar {
  padding-bottom: 16rpx;
}

.single-page-tip {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-sub);
}

.share-list {
  display: flex;
  padding: 10rpx 24rpx 40rpx;
}

.share-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1.4;
}

.share-item::after {
  border: none;
}

.share-emoji {
  font-size: 56rpx;
}

.share-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.share-space {
  height: 20rpx;
}

.qr-dialog {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.qr-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 400rpx;
  height: 400rpx;
  margin: 28rpx 0 20rpx;
  border-radius: var(--radius);
  background: #f7fafa;
}

.qr-img {
  width: 360rpx;
  height: 360rpx;
}

.qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-placeholder-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

.qr-placeholder-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.qr-tip {
  /* 弹窗是 align-items: center 的纵向 flex：不撑满宽度的话 text 节点会按内容撑开，
     长文案（例如「活动时间、集合地点、同行成员在小程序内都能看到…」）就会一行顶出弹窗、左右被裁掉 */
  align-self: stretch;
  padding: 0 40rpx;
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.5;
  text-align: center;
}

.qr-sub-tip {
  align-self: stretch;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-light);
  line-height: 1.5;
  text-align: center;
}

.qr-btn {
  width: 100%;
  margin-top: 26rpx;
}

/* 审核状态提示条：仅发起人可见（未过审的活动其他人拿不到数据） */
.audit-banner {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius);
}

.audit-banner.pending {
  background: rgba(217, 134, 0, 0.12);
}

.audit-banner.rejected {
  background: rgba(227, 77, 89, 0.12);
}

.audit-banner-title {
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.audit-banner.pending .audit-banner-title {
  color: #d98600;
}

.audit-banner.rejected .audit-banner-title {
  color: #e34d59;
}

.audit-banner-desc {
  color: var(--text-sub);
  font-size: 24rpx;
  line-height: 36rpx;
}
