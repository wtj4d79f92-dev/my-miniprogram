.detail-page {
  background: var(--bg);
}

.detail-body {
  padding: 0 24rpx;
}

.cover {
  position: relative;
  height: 380rpx;
  margin-top: 16rpx;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-poster {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--brand);
  font-size: 40rpx;
  font-weight: 700;
}

.cover-title {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.cover-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.cover-type {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  color: var(--text);
}

.main-card {
  margin-top: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.difficulty {
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 181, 120, 0.12);
  color: var(--brand);
  font-size: 22rpx;
}

.title-tag {
  margin-right: 10rpx;
}

.detail-title {
  width: 100%;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
}

.organizer-row {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
}

.organizer-name {
  flex: 1;
  margin: 0 14rpx;
  font-size: 28rpx;
  color: var(--text);
}

.organizer-date {
  font-size: 24rpx;
  color: var(--text-sub);
}

.info-divider {
  margin: 10rpx 0 22rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  margin-bottom: 22rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.info-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: var(--text);
}

.status {
  margin-top: 6rpx;
  font-size: 28rpx;
}

.status.recruiting {
  color: var(--brand);
}

.status.full {
  color: var(--text-light);
}

.status.closed {
  color: var(--text-light);
}

.card + .card {
  margin-top: 24rpx;
}

.inner-head {
  margin: 0 0 20rpx;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
}

.member {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 22rpx;
}

.member-name {
  width: 100%;
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-sub);
}

.member-empty {
  font-size: 26rpx;
  color: var(--text-light);
}

.desc-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text);
  white-space: pre-wrap;
}

/* 底部操作栏不浮动：避免挡住滚动内容，也保证按钮点击不会被内容层拦截 */
.action-bar {
  flex: none;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 2rpx solid var(--line);
}

.agree-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  border: 2rpx solid #cbd5d5;
  color: #ffffff;
  font-size: 22rpx;
}

.checkbox.checked {
  background: var(--brand);
  border-color: var(--brand);
}

.agree-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.agree-link {
  font-size: 24rpx;
  color: var(--brand);
}

.action-row {
  display: flex;
  align-items: center;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 88rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.share-icon {
  font-size: 32rpx;
  color: var(--brand);
}

.main-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.main-btn.disabled {
  background: #e4eaea;
  color: #a9b3b3;
}

.main-btn.outline {
  background: #ffffff;
  border: 2rpx solid var(--brand);
  color: var(--brand);
}

.not-found {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.not-found-icon {
  font-size: 90rpx;
}

.not-found-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-sub);
}

.not-found-btn {
  margin-top: 40rpx;
  padding: 0 70rpx;
}

.share-list {
  display: flex;
  padding: 10rpx 24rpx 40rpx;
}

.share-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1.4;
}

.share-item::after {
  border: none;
}

.share-emoji {
  font-size: 56rpx;
}

.share-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.share-space {
  height: 20rpx;
}

.qr-dialog {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.qr-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 400rpx;
  height: 400rpx;
  margin: 28rpx 0 20rpx;
  border-radius: 20rpx;
  background: #f7fafa;
}

.qr-img {
  width: 360rpx;
  height: 360rpx;
}

.qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-placeholder-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

.qr-placeholder-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.qr-tip {
  font-size: 22rpx;
  color: var(--text-light);
}

.qr-btn {
  width: 100%;
  margin-top: 26rpx;
}
