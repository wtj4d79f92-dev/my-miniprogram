<view class="page tab-page">
  <navigation-bar title="我的" back="{{false}}" color="#2D3748" background="#BFAF92"></navigation-bar>

  <scroll-view class="page-scroll tab-page-scroll" scroll-y>
    <view class="scroll-body">
      <!-- 用户卡片 -->
      <view class="user-card card" hover-class="card-press" hover-start-time="0" hover-stay-time="80">
        <view class="user-main" bindtap="onUserCardTap">
          <avatar
            url="{{userAvatar}}"
            color="{{user ? user.avatarColor : '#CBD5D5'}}"
            text="{{user ? user.avatarText : '友'}}"
            size="lg"
          ></avatar>
          <view class="user-info">
            <text class="user-name">{{user ? user.nickName : '未登录'}}</text>
            <text wx:if="{{user && showUserId}}" class="user-id">ID：{{user.userId}}</text>
            <text class="user-bio">{{user ? (user.bio || '和有趣的人一起出发') : '登录后可使用报名、发布等功能'}}</text>
          </view>
          <text class="user-arrow">›</text>
        </view>
        <view wx:if="{{!user}}" class="btn-primary login-btn" bindtap="onLoginTap" hover-class="btn-press" hover-start-time="0" hover-stay-time="80"><text>微信一键登录</text></view>

        <!-- 统计数并入用户卡片：点击统计项进入对应活动列表 -->
        <view class="stats">
          <view class="stat-item" data-tab="joined" bindtap="goActivityList" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">
            <text class="stat-value">{{joinedCount}}</text>
            <text class="stat-label">我参与的</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item" data-tab="published" bindtap="goActivityList" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">
            <text class="stat-value">{{publishedCount}}</text>
            <text class="stat-label">我发布的</text>
          </view>
        </view>
      </view>

      <!-- 完善资料提示 -->
      <view wx:if="{{needProfile}}" class="profile-tip" bindtap="openProfile" hover-class="card-press" hover-start-time="0" hover-stay-time="80">
        <text class="profile-tip-text">完善头像昵称，让好友认出你</text>
        <text class="profile-tip-arrow">›</text>
      </view>

      <!-- 功能入口 -->
      <view class="entry-group card">
        <view class="entry" bindtap="goMessage" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
          <image wx:if="{{!iconErrorMap.message}}" class="entry-icon" src="{{entryIcons.message}}" mode="aspectFit" data-key="message" binderror="onEntryIconError" />
          <text wx:else class="entry-icon entry-icon-emoji">🔔</text>
          <text class="entry-title">消息</text>
          <text wx:if="{{unreadCount}}" class="entry-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
          <text class="entry-arrow">›</text>
        </view>
        <view wx:if="{{user && !user.phone}}" class="entry" bindtap="openPhone" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
          <image wx:if="{{!iconErrorMap.phone}}" class="entry-icon" src="{{entryIcons.phone}}" mode="aspectFit" data-key="phone" binderror="onEntryIconError" />
          <text wx:else class="entry-icon entry-icon-emoji">📱</text>
          <view class="entry-main">
            <text class="entry-title">绑定手机号（可选）</text>
            <text class="entry-desc">用于找回账号与活动联系</text>
          </view>
          <text class="entry-arrow">›</text>
        </view>
        <view class="entry" bindtap="goPublish" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
          <image wx:if="{{!iconErrorMap.publish}}" class="entry-icon" src="{{entryIcons.publish}}" mode="aspectFit" data-key="publish" binderror="onEntryIconError" />
          <text wx:else class="entry-icon entry-icon-emoji">✨</text>
          <text class="entry-title">发起新活动</text>
          <text class="entry-arrow">›</text>
        </view>
        <view class="entry" bindtap="goSquare" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
          <image wx:if="{{!iconErrorMap.square}}" class="entry-icon" src="{{entryIcons.square}}" mode="aspectFit" data-key="square" binderror="onEntryIconError" />
          <text wx:else class="entry-icon entry-icon-emoji">🧭</text>
          <text class="entry-title">逛逛活动广场</text>
          <text class="entry-arrow">›</text>
        </view>
        <view class="entry" bindtap="goFeedback" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
          <image wx:if="{{!iconErrorMap.feedback}}" class="entry-icon" src="{{entryIcons.feedback}}" mode="aspectFit" data-key="feedback" binderror="onEntryIconError" />
          <text wx:else class="entry-icon entry-icon-emoji">💬</text>
          <text class="entry-title">意见反馈</text>
          <text class="entry-arrow">›</text>
        </view>
        <!-- 客服入口：open-type="contact" 直达微信客服会话，审核要求小程序内可联系到运营 -->
        <view class="entry">
          <button class="contact-btn" open-type="contact" hover-class="none">
            <image wx:if="{{!iconErrorMap.support}}" class="entry-icon" src="{{entryIcons.support}}" mode="aspectFit" data-key="support" binderror="onEntryIconError" />
            <text wx:else class="entry-icon entry-icon-emoji">🎧</text>
            <text class="entry-title">联系客服</text>
            <text class="entry-arrow">›</text>
          </button>
        </view>
        <view wx:if="{{isAdmin}}" class="entry" bindtap="goAdminAudit" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
          <image wx:if="{{!iconErrorMap.audit}}" class="entry-icon" src="{{entryIcons.audit}}" mode="aspectFit" data-key="audit" binderror="onEntryIconError" />
          <text wx:else class="entry-icon entry-icon-emoji">🛡️</text>
          <view class="entry-main">
            <text class="entry-title">活动审核</text>
            <text class="entry-desc">审阅用户提交的活动</text>
          </view>
          <text class="entry-arrow">›</text>
        </view>
        <view class="entry" bindtap="showAbout" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
          <image wx:if="{{!iconErrorMap.about}}" class="entry-icon" src="{{entryIcons.about}}" mode="aspectFit" data-key="about" binderror="onEntryIconError" />
          <text wx:else class="entry-icon entry-icon-emoji">ℹ️</text>
          <text class="entry-title">关于旷行吖</text>
          <text class="entry-arrow">›</text>
        </view>
        <!-- 设置入口：并入功能卡片，协议与账号管理在设置页统一展示 -->
        <view class="entry" bindtap="openSettings" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
          <image wx:if="{{!iconErrorMap.settings}}" class="entry-icon" src="{{entryIcons.settings}}" mode="aspectFit" data-key="settings" binderror="onEntryIconError" />
          <text wx:else class="entry-icon entry-icon-emoji">⚙️</text>
          <text class="entry-title">设置</text>
          <text class="entry-arrow">›</text>
        </view>
      </view>

      <view class="version"><text>{{versionText}}</text></view>
    </view>
  </scroll-view>

  <!-- 设置页：全屏覆盖，避免与底部 tabBar 和半屏弹层叠加 -->
  <view wx:if="{{showSettings}}" class="settings-page">
    <navigation-bar title="设置" back="{{true}}" color="#2D3748" background="#BFAF92" bindback="closeSettings"></navigation-bar>
    <scroll-view class="settings-page-scroll" scroll-y>
      <view class="settings-content">
        <view class="entry-group card">
          <view class="settings-row" bindtap="openServiceFromSettings" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
            <image wx:if="{{!iconErrorMap.service}}" class="entry-icon" src="{{entryIcons.service}}" mode="aspectFit" data-key="service" binderror="onEntryIconError" />
            <text wx:else class="entry-icon entry-icon-emoji">📄</text>
            <text class="settings-title">用户服务协议</text>
            <text class="entry-arrow">›</text>
          </view>
          <view class="settings-row" bindtap="openPrivacyFromSettings" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
            <image wx:if="{{!iconErrorMap.privacy}}" class="entry-icon" src="{{entryIcons.privacy}}" mode="aspectFit" data-key="privacy" binderror="onEntryIconError" />
            <text wx:else class="entry-icon entry-icon-emoji">🔒</text>
            <text class="settings-title">隐私政策</text>
            <text class="entry-arrow">›</text>
          </view>
          <view wx:if="{{user}}" class="settings-row settings-row-danger" bindtap="deleteAccountFromSettings" hover-class="row-press" hover-start-time="0" hover-stay-time="80">
            <image wx:if="{{!iconErrorMap.remove}}" class="entry-icon" src="{{entryIcons.remove}}" mode="aspectFit" data-key="remove" binderror="onEntryIconError" />
            <text wx:else class="entry-icon entry-icon-emoji">🗑️</text>
            <view class="settings-row-main">
              <text class="settings-title">注销账号</text>
              <text class="settings-desc">删除账号与全部相关数据，不可恢复</text>
            </view>
            <text class="entry-arrow">›</text>
          </view>
        </view>
        <view class="settings-version"><text>{{versionText}}</text></view>
      </view>
    </scroll-view>
  </view>

  <!-- 资料编辑弹窗 -->
  <view wx:if="{{showProfile}}">
    <view class="mask" bindtap="closeProfile"></view>
    <view class="dialog profile-dialog">
      <view class="profile-head">
        <text class="profile-title">完善头像昵称</text>
        <text class="sheet-close" bindtap="closeProfile">✕</text>
      </view>
      <text class="profile-sub">设置后将展示在你的活动卡片中</text>
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">
        <avatar url="{{editAvatar}}" color="{{user.avatarColor}}" text="{{editNickName}}" size="lg"></avatar>
        <text class="avatar-picker-tip">点击选择微信头像</text>
      </button>
      <view class="nick-row">
        <text class="nick-label">昵称</text>
        <input
          class="nick-input"
          type="nickname"
          value="{{editNickName}}"
          maxlength="20"
          placeholder="请输入昵称"
          bindinput="onNickInput"
        />
      </view>
      <view class="btn-primary profile-save" bindtap="saveProfile" hover-class="btn-press" hover-start-time="0" hover-stay-time="80"><text>{{saving ? '保存中…' : '保存'}}</text></view>
      <view class="btn-ghost profile-skip" bindtap="closeProfile" hover-class="btn-press" hover-start-time="0" hover-stay-time="80"><text>暂不完善</text></view>
    </view>
  </view>

  <!-- 手机号绑定弹窗 -->
  <view wx:if="{{showPhone}}">
    <view class="mask" bindtap="closePhone"></view>
    <view class="dialog phone-dialog">
      <view class="profile-head">
        <text class="profile-title">绑定手机号（可选）</text>
        <text class="sheet-close" bindtap="closePhone">✕</text>
      </view>
      <block wx:if="{{useMock}}">
        <input
          class="login-input"
          type="number"
          maxlength="11"
          placeholder="请输入 11 位手机号"
          value="{{phoneInput}}"
          bindinput="onPhoneInput"
        />
      </block>
      <view class="phone-agree">
        <view class="checkbox {{phoneAgreed ? 'checked' : ''}}" bindtap="togglePhoneAgree"><text wx:if="{{phoneAgreed}}">✓</text></view>
        <text class="agree-text" bindtap="togglePhoneAgree">我已阅读并同意</text>
        <text class="agree-link" catchtap="openService">《用户服务协议》</text>
        <text class="agree-text">和</text>
        <text class="agree-link" catchtap="openPrivacy">《隐私政策》</text>
      </view>
      <block wx:if="{{useMock}}">
        <view
          class="btn-primary phone-btn {{phoneAgreed ? '' : 'disabled'}}"
          bindtap="submitPhoneMock"
          hover-class="btn-press"
          hover-start-time="0"
          hover-stay-time="80"
        ><text>{{binding ? '绑定中…' : '绑定手机号'}}</text></view>
      </block>
      <block wx:else>
        <button
          class="btn-primary phone-btn {{phoneAgreed ? '' : 'disabled'}}"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
          hover-class="btn-press"
          hover-start-time="0"
          hover-stay-time="80"
        ><text>{{binding ? '绑定中…' : '绑定手机号'}}</text></button>
      </block>
    </view>
  </view>

  <agreement-modal id="agreement-modal"></agreement-modal>
  <login-modal id="login-modal" bindlogin="onLogin"></login-modal>
</view>
