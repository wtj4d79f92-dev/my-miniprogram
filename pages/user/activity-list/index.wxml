<view class="page">
  <navigation-bar title="我的活动" color="#2D3748" background="#FFFFFF"></navigation-bar>

  <view class="tabs">
    <view class="tab {{tab === 'joined' ? 'active' : ''}}" data-tab="joined" bindtap="switchTab">
      <text>我参与的</text>
    </view>
    <view class="tab {{tab === 'published' ? 'active' : ''}}" data-tab="published" bindtap="switchTab">
      <text>我发布的</text>
    </view>
  </view>

  <scroll-view
    class="page-scroll"
    scroll-y
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="scroll-body">
      <activity-card
        wx:for="{{list}}"
        wx:key="id"
        act="{{item}}"
        showToolbar="{{tab === 'published'}}"
        bindtapcard="onCardTap"
        bindtoggle="onToggle"
      >
        <!-- 已到期的活动不能再重提（服务端 update 同样会拒绝），不再展示「修改后重新提交」 -->
        <view slot="footer" wx:if="{{item.auditRejected && !item.expired}}" class="audit-box">
          <view class="audit-reason">
            <text class="audit-label">未通过原因</text>
            <text class="audit-text">{{item.auditReason}}</text>
          </view>
          <view class="audit-edit" data-id="{{item.id}}" catchtap="onEdit">
            <text>修改后重新提交</text>
          </view>
        </view>
        <view slot="footer" wx:elif="{{item.auditPending && !item.expired && tab === 'published'}}" class="audit-box">
          <text class="audit-pending-text">已提交审核，通过后将展示在广场</text>
        </view>
        <view slot="footer" wx:elif="{{item.expired && tab === 'published'}}" class="audit-box">
          <text class="audit-pending-text">活动发布已超过 7 天，已自动关闭；需要继续组队请重新发布</text>
        </view>
      </activity-card>

      <empty-state
        wx:if="{{!loading && !list.length && tab === 'joined'}}"
        icon="🎒"
        text="还没有参与活动"
        buttonText="去逛逛"
        bindaction="goSquare"
      ></empty-state>

      <empty-state
        wx:if="{{!loading && !list.length && tab === 'published'}}"
        icon="📣"
        text="还没有发布过活动"
        buttonText="去发布"
        bindaction="goPublish"
      ></empty-state>

      <view wx:if="{{loading}}" class="loading-tip"><text>加载中…</text></view>
      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <login-modal id="login-modal" bindlogin="onLogin"></login-modal>
</view>
