.organizer-page {
  background: var(--page-bg);
}

.organizer-fixed {
  flex: none;
  background: var(--page-bg);
}

.organizer-list-scroll {
  flex: 1;
  height: 0;
}

.organizer-list-body {
  padding-bottom: 40rpx;
}

.organizer-hero {
  position: relative;
  width: 100%;
  height: 340rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.3);
}

.organizer-hero-image,
.organizer-hero-fallback,
.organizer-hero-shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.organizer-hero-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.organizer-hero-initial {
  color: rgba(255, 255, 255, 0.45);
  font-size: 180rpx;
  font-weight: 700;
  line-height: 1;
}

.organizer-hero-shade {
  background: linear-gradient(180deg, rgba(25, 25, 25, 0) 35%, rgba(25, 25, 25, 0.72) 100%);
}

.organizer-hero-name {
  position: absolute;
  left: 50%;
  bottom: 28rpx;
  max-width: calc(100% - 72rpx);
  padding: 10rpx 24rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.46);
  border-radius: 0;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.45);
  transform: translateX(-50%);
  word-break: break-all;
}

.organizer-cover-edit {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  padding: 12rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  background: rgba(20, 30, 30, 0.46);
  color: #ffffff;
  font-size: 23rpx;
  line-height: 1;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(12rpx);
}

.organizer-cover-edit-press {
  opacity: 0.72;
}

.organizer-hero-loading {
  background: var(--card-sheen);
}

.organizer-content {
  padding: 0 24rpx;
}

.organizer-section-head {
  margin-top: 28rpx;
}

.organizer-count {
  color: var(--text-on-bg-sub);
  font-size: 23rpx;
}

.load-more {
  padding: 20rpx 0 30rpx;
  text-align: center;
}

.load-more-text {
  color: var(--text-on-bg-sub);
  font-size: 24rpx;
}

.loading-tip {
  padding: 48rpx 0;
  text-align: center;
  color: var(--text-on-bg-sub);
  font-size: 26rpx;
}
