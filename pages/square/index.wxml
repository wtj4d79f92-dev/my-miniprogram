<view class="page tab-page">
  <navigation-bar title="活动广场" back="{{false}}" color="#2D3748" background="#BFAF92"></navigation-bar>

  <view class="square-head">
    <!-- 城市栏：定位与切换城市合并成一个胶囊，点开即城市选择弹层 -->
    <view class="locate-bar">
      <view class="city-pill" bindtap="openCityPicker" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">
        <text class="locate-icon">📍</text>
        <text class="city-pill-name">{{locationDenied ? '定位未开启' : cityLabel}}</text>
        <text class="city-pill-arrow">▾</text>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-row">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="{{texts.searchPlaceholderSquare}}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onKeywordConfirm"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onKeywordClear" hover-class="row-press" hover-start-time="0" hover-stay-time="80">✕</text>
      <view class="search-submit" bindtap="onKeywordConfirm" hover-class="btn-press" hover-start-time="0" hover-stay-time="80"><text>搜索</text></view>
    </view>

    <!-- 排序栏 + 筛选（活动类型 / 具体日期 / 星期几） -->
    <view class="sort-bar">
      <view class="sort-options">
        <text
          class="sort-option {{sort === item.value ? 'active' : ''}}"
          wx:for="{{sortOptions}}"
          wx:key="value"
          data-sort="{{item.value}}"
          bindtap="onSortTap"
          hover-class="btn-press"
          hover-start-time="0"
          hover-stay-time="80"
        >{{item.label}}</text>
      </view>
      <view class="sort-filters">
        <view class="type-filter {{type !== 'all' ? 'active' : ''}}" bindtap="toggleType" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">
          <text class="type-text">{{typeLabel}}</text>
          <text class="type-arrow">{{typeOpen ? '▲' : '▼'}}</text>
        </view>
        <view class="date-filter {{date ? 'active' : ''}}" bindtap="openDatePicker" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">
          <text class="date-text">{{dateLabel}}</text>
          <text wx:if="{{date}}" class="date-clear" catchtap="onDateClear" hover-class="row-press" hover-start-time="0" hover-stay-time="80">✕</text>
        </view>
        <view class="weekday-filter" bindtap="toggleWeekday" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">
          <text class="weekday-text">{{weekdayLabel}}</text>
          <text class="weekday-arrow">{{weekdayOpen ? '▲' : '▼'}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{typeOpen}}" class="type-panel">
      <view
        class="type-panel-item {{type === item.key ? 'active' : ''}}"
        wx:for="{{typeOptions}}"
        wx:key="key"
        data-type="{{item.key}}"
        bindtap="onTypeSelect"
        hover-class="btn-press"
        hover-start-time="0"
        hover-stay-time="80"
      >{{item.emoji ? item.emoji + ' ' : ''}}{{item.name}}</view>
    </view>

    <view wx:if="{{weekdayOpen}}" class="weekday-panel">
      <view
        class="weekday-item {{weekday === item.value ? 'active' : ''}}"
        wx:for="{{weekdayOptions}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onWeekdayTap"
        hover-class="btn-press"
        hover-start-time="0"
        hover-stay-time="80"
      >{{item.label}}</view>
    </view>
  </view>

  <scroll-view
    class="page-scroll tab-page-scroll"
    scroll-y
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onScrollToLower"
    lower-threshold="80"
  >
    <view class="scroll-body">
      <view wx:if="{{fallbackTip}}" class="fallback-tip"><text>{{fallbackTip}}</text></view>

      <activity-card
        wx:for="{{list}}"
        wx:key="id"
        act="{{item}}"
        bindtapcard="onCardTap"
      ></activity-card>

      <empty-state
        wx:if="{{empty}}"
        icon="🔍"
        text="没有找到相关活动，发布一个吧"
        buttonText="去发布"
        bindaction="goPublish"
      ></empty-state>

      <view wx:if="{{list.length}}" class="load-more">
        <text wx:if="{{loadingMore}}" class="load-more-text">加载中…</text>
        <text wx:elif="{{hasMore}}" class="load-more-text" bindtap="onLoadMoreTap" hover-class="row-press" hover-start-time="0" hover-stay-time="80">点击加载更多</text>
        <text wx:else class="load-more-text">已经到底啦</text>
      </view>

      <view wx:if="{{loading}}" class="loading-tip"><text>加载中…</text></view>
    </view>
  </scroll-view>

  <view class="fab" bindtap="goPublish" hover-class="fab-press" hover-start-time="0" hover-stay-time="80">
    <text class="fab-plus">＋</text>
    <text class="fab-text">发布</text>
  </view>

  <city-picker id="city-picker" city="{{city}}" bindchange="onCityChange" bindlocate="onLocateTap"></city-picker>
  <calendar-picker id="calendar-picker" bindconfirm="onDateConfirm"></calendar-picker>
  <login-modal id="login-modal" bindlogin="onLogin"></login-modal>
</view>
