.square-head {
  padding: 16rpx 24rpx 0;
  background: rgba(255, 255, 255, 0.96);
  z-index: 10;
}

.locate-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
}

.locate-left {
  display: flex;
  align-items: center;
}

.locate-icon {
  font-size: 26rpx;
}

.locate-city {
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.locate-switch {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
}

.search-row {
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 10rpx 0 24rpx;
  border-radius: 999rpx;
  background: #f4f7f6;
}

.search-icon {
  font-size: 24rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--text);
}

.search-clear {
  padding: 0 12rpx;
  color: var(--text-light);
  font-size: 26rpx;
}

.search-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  color: #ffffff;
  font-size: 26rpx;
}

.type-tabs {
  margin-top: 20rpx;
  white-space: nowrap;
}

.type-tabs-inner {
  display: flex;
  align-items: center;
}

.type-tab {
  flex: none;
  margin-right: 16rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f4f7f6;
  color: var(--text-sub);
  font-size: 26rpx;
}

.type-tab.active {
  background: var(--brand);
  color: #ffffff;
  font-weight: 600;
}

.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.sort-options {
  display: flex;
  align-items: center;
}

.sort-option {
  margin-right: 32rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.sort-option.active {
  color: var(--brand);
  font-weight: 600;
}

.weekday-filter {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f4f7f6;
}

.weekday-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.weekday-arrow {
  margin-left: 8rpx;
  font-size: 18rpx;
  color: var(--text-light);
}

.weekday-panel {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 16rpx 8rpx 8rpx;
  border-radius: 16rpx;
  background: #f7fafa;
}

.weekday-item {
  width: 25%;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
}

.weekday-item.active {
  color: var(--brand);
  font-weight: 600;
}

.fallback-tip {
  margin: 20rpx 0 4rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #fff7e8;
  color: #b26a00;
  font-size: 24rpx;
}

.load-more {
  padding: 24rpx 0 10rpx;
  text-align: center;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--text-light);
}

.loading-tip {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.fab {
  position: fixed;
  left: 50%;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  box-shadow: 0 12rpx 32rpx rgba(0, 181, 120, 0.35);
  color: #ffffff;
}

.fab-plus {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.fab-text {
  font-size: 28rpx;
  font-weight: 600;
}
