.square-head {
  padding: 16rpx 24rpx 0;
  background: rgba(255, 255, 255, 0.96);
  z-index: 10;
}

.locate-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
}

.locate-left {
  display: flex;
  align-items: center;
}

.locate-icon {
  font-size: 26rpx;
}

.locate-city {
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.locate-switch {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
}

.search-row {
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 10rpx 0 24rpx;
  border-radius: 999rpx;
  background: #f4f7f6;
}

.search-icon {
  font-size: 24rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--text);
}

.search-clear {
  padding: 0 12rpx;
  color: var(--text-light);
  font-size: 26rpx;
}

.search-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  color: #ffffff;
  font-size: 26rpx;
}

.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 排序 + 三个筛选胶囊：窄机型放不下时换行，别把胶囊挤出屏幕 */
  flex-wrap: wrap;
  row-gap: 12rpx;
  margin-top: 20rpx;
}

.sort-options {
  display: flex;
  align-items: center;
}

.sort-option {
  margin-right: 24rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.sort-option:last-child {
  margin-right: 0;
}

.sort-option.active {
  color: var(--brand);
  font-weight: 600;
}

.sort-filters {
  display: flex;
  align-items: center;
}

.type-filter {
  display: flex;
  align-items: center;
  margin-right: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f7f6;
}

.type-filter.active {
  background: var(--brand-soft);
}

.type-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.type-filter.active .type-text {
  color: var(--brand);
  font-weight: 600;
}

.type-arrow {
  margin-left: 6rpx;
  font-size: 18rpx;
  color: var(--text-light);
}

.date-filter {
  display: flex;
  align-items: center;
  margin-right: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f7f6;
}

.date-filter.active {
  background: var(--brand-soft);
}

.date-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.date-filter.active .date-text {
  color: var(--brand);
  font-weight: 600;
}

.date-clear {
  /* 点 ✕ 清空日期：加点内边距把热区撑到看得见的范围，同时不把胶囊撑高 */
  margin-left: 6rpx;
  padding: 0 8rpx;
  line-height: 34rpx;
  font-size: 22rpx;
  color: var(--brand);
}

.weekday-filter {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f7f6;
}

.weekday-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.weekday-arrow {
  margin-left: 8rpx;
  font-size: 18rpx;
  color: var(--text-light);
}

.type-panel {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 16rpx 8rpx 8rpx;
  border-radius: 16rpx;
  background: #f7fafa;
}

.type-panel-item {
  /* 预留 1px，避免部分机型取整后每行只排得下 3 个 */
  flex: 0 0 calc(25% - 1px);
  min-width: 0;
  padding: 14rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
}

.type-panel-item.active {
  color: var(--brand);
  font-weight: 600;
}

.weekday-panel {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 16rpx 8rpx 8rpx;
  border-radius: 16rpx;
  background: #f7fafa;
}

.weekday-item {
  /* 预留 1px，避免部分机型取整后每行只排得下 3 个 */
  flex: 0 0 calc(25% - 1px);
  min-width: 0;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
}

.weekday-item.active {
  color: var(--brand);
  font-weight: 600;
}

.fallback-tip {
  margin: 20rpx 0 4rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #fff7e8;
  color: #b26a00;
  font-size: 24rpx;
}

.load-more {
  padding: 24rpx 0 10rpx;
  text-align: center;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--text-light);
}

.loading-tip {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.fab {
  position: fixed;
  left: 50%;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  box-shadow: 0 12rpx 32rpx rgba(0, 181, 120, 0.35);
  color: #ffffff;
}

.fab-plus {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.fab-text {
  font-size: 28rpx;
  font-weight: 600;
}
