.tab-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa5b1;
}

.tab-item.active .tab-icon {
  background-color: #00b578;
}

.tab-item.active .tab-text {
  color: #00b578;
  font-weight: 600;
}
