.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  /* 框架把 tabBar 根节点挂到独立渲染层时是 pointer-events: none，
     这里显式打开，否则底部导航收不到点击事件 */
  pointer-events: auto;
  display: flex;
  height: calc(110rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /*
   * 半透明玻璃底栏：和卡片同一套材质，比纯白条更贴暖砂底色。
   * tabBar 拿不到 page 上的 CSS 变量，颜色一律写字面量；透明度留 0.86，文字照常读得清。
   * 不做 backdrop-filter：tabBar 是独立渲染层，底下透出来的只有页面底色，磨砂没有可磨的内容。
   */
  background: rgba(255, 255, 255, 0.86);
  /*
   * 圆角与卡片 / 横幅 / 搜索框对齐（page 上的 --radius：24rpx）。
   * tabBar 拿不到 page 的 CSS 变量，这里写字面量，改全局圆角时记得同步。
   * 顶端不再描那条硬边（border-top），改成一片大范围的柔和上投影 ——
   * 底栏是浮在暖砂上的一层"面"，靠投影和底色拉开，不靠描边。
   */
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 26rpx rgba(58, 44, 24, 0.10), 0 -24rpx 64rpx rgba(58, 44, 24, 0.12);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* tabBar 的样式作用域拿不到 page 上的 CSS 变量，颜色一律用字面量；
     安全区一起算进点击区域，否则 tabBar 下半截点不动 */
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 按下：整个 tab 下沉一点，抬手弹回 */
.tab-press {
  transform: translateY(4rpx) scale(0.94);
  transition: transform 90ms cubic-bezier(0.4, 0, 1, 1);
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-color: #9aa5b1;
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

/* 未读小红点：白色描边让它在图标和背景上都看得清 */
.tab-badge {
  position: absolute;
  top: -4rpx;
  right: -12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e5484d;
  border: 3rpx solid #ffffff;
  box-sizing: border-box;
}

