/**app.wxss**/
page {
  --brand: #00b578;
  --brand-dark: #00996a;
  --brand-soft: #e6f8f1;
  --cyan: #45b7d1;
  --mint: #4ecdc4;
  --orange: #ff7d00;
  --text: #2d3748;
  --text-sub: #718096;
  --text-light: #9aa5b1;
  --line: #edf2f2;
  --bg: #f5f8f7;
  --card: #ffffff;
  --radius: 20rpx;
  --shadow: 0 6rpx 24rpx rgba(45, 55, 72, 0.06);

  background: linear-gradient(180deg, #ffffff 0%, #f2faf7 42%, #eef7fb 100%);
  background-attachment: fixed;
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* tabBar 页面：底部预留自定义 tabBar 的高度，避免滚动内容被导航栏压住 */
.tab-page {
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

/* 页面滚动容器：配合自定义 tabBar，底部预留安全距离 */
.page-scroll {
  flex: 1;
  height: 0;
}

.scroll-body {
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.tab-page-scroll .scroll-body {
  /* 悬浮发布按钮浮在列表右下角，留出与按钮等高的空白 */
  padding-bottom: 140rpx;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 24rpx;
  box-sizing: border-box;
}

/* 分区标题 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.section-more {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 字段标签 + 值 */
.field-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.field-label {
  flex: none;
  width: 128rpx;
  color: var(--text-sub);
  font-size: 26rpx;
}

.field-value {
  flex: 1;
  color: var(--text);
  font-size: 26rpx;
  word-break: break-all;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.tag-brand {
  color: var(--brand);
  background: var(--brand-soft);
}

.tag-orange {
  color: var(--orange);
  background: rgba(255, 125, 0, 0.1);
}

.tag-gray {
  color: var(--text-sub);
  background: #f1f3f4;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #00b578 0%, #43cea2 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary.disabled {
  background: #dfe6e5;
  color: #b3bcbc;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 600;
  background: #ffffff;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 999rpx;
  background: #f1f3f4;
  color: var(--text-sub);
  font-size: 26rpx;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.divider {
  height: 2rpx;
  background: var(--line);
}

/* 半屏 / 居中弹层通用 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 30, 30, 0.45);
  z-index: 900;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* tabBar 页面上的半屏弹层整体上移，否则会被自定义 tabBar 盖住底部操作按钮 */
.tab-page .sheet {
  bottom: calc(110rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 32rpx;
  color: var(--text-light);
  padding: 0 8rpx;
}

.dialog {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 901;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
}
